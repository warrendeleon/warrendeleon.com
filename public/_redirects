# Every legacy path lives here rather than in astro.config.mjs `redirects:`.
# Astro's static redirects emit a 200 HTML stub carrying a meta refresh and a
# noindex tag; Cloudflare Pages reads this file at the edge and answers with a
# real 301. Search Console counts the stubs as "Excluded by 'noindex'" and the
# chains as "Redirect error", so anything a crawler might still hold belongs
# here. _redirects wins over a matching static file, so both can coexist.

# Old /work/ and /work-xp/ paths → /work-experience/
/work/* /work-experience/:splat 301
/work-xp/* /work-experience/:splat 301
/es/work/* /es/work-experience/:splat 301
/ca/work/* /ca/work-experience/:splat 301
/tl/work/* /tl/work-experience/:splat 301
/sky /work-experience/sky/ 301
/sky/ /work-experience/sky/ 301

# Removed /hiring page → home, each locale to its own home so the visitor
# keeps the language they arrived in.
/hiring / 301
/hiring/ / 301
/es/hiring /es/ 301
/es/hiring/ /es/ 301
/ca/hiring /ca/ 301
/ca/hiring/ /ca/ 301
/tl/hiring /tl/ 301
/tl/hiring/ /tl/ 301

# /cv/ and /education/ folded into /work-experience/ (2026-07). The PDF
# download and the qualifications section live there now.
/cv /work-experience/ 301
/cv/ /work-experience/ 301
/education /work-experience/ 301
/education/ /work-experience/ 301
/es/cv /es/work-experience/ 301
/es/cv/ /es/work-experience/ 301
/es/education /es/work-experience/ 301
/es/education/ /es/work-experience/ 301
/ca/cv /ca/work-experience/ 301
/ca/cv/ /ca/work-experience/ 301
/ca/education /ca/work-experience/ 301
/ca/education/ /ca/work-experience/ 301
/tl/cv /tl/work-experience/ 301
/tl/cv/ /tl/work-experience/ 301
/tl/education /tl/work-experience/ 301
/tl/education/ /tl/work-experience/ 301

# Translated tag slugs, retired by 60f0226 (content repo) when tags became
# English in every locale. These MUST sit above the /blog/tag/* wildcards
# below: rules match in file order, and the wildcard would otherwise rewrite
# `contratación` to /es/blog/tags/contratación/, a slug that has never
# existed — a 301 into a 404. That dead end is why the Search Console "Not
# found" bucket kept failing validation: the URL still ended in a 404, so
# every re-validation reported the same error.
#
# Spelled percent-encoded, which is what actually reaches the edge — a
# browser and a crawler both send /es/blog/tag/contrataci%C3%B3n/ on the
# wire, never the literal accented path.
/es/blog/tag/consejos-de-carrera/ /es/blog/tags/career-advice/ 301
/es/blog/tag/contrataci%C3%B3n/ /es/blog/tags/hiring/ 301
/es/blog/tag/gesti%C3%B3n-de-ingenier%C3%ADa/ /es/blog/tags/engineering-management/ 301
/ca/blog/tag/consells-de-carrera/ /ca/blog/tags/career-advice/ 301
/ca/blog/tag/contractaci%C3%B3/ /ca/blog/tags/hiring/ 301
/ca/blog/tag/gesti%C3%B3-d-enginyeria/ /ca/blog/tags/engineering-management/ 301
/tl/blog/tag/pagkuha-ng-empleyado/ /tl/blog/tags/hiring/ 301

# Tag pages moved from /blog/tag/:tag to /blog/tags/:tag
/blog/tag/* /blog/tags/:splat 301
/es/blog/tag/* /es/blog/tags/:splat 301
/ca/blog/tag/* /ca/blog/tags/:splat 301
/tl/blog/tag/* /tl/blog/tags/:splat 301

