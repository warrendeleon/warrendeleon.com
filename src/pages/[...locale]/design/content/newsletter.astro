---
import DesignLayout from '../../../../components/design/DesignLayout.astro';
import { md } from '../../../../lib/inline-markup';
import SpecimenCard from '../../../../components/design/SpecimenCard.astro';
import { getLocalePath, localeStaticPaths, type Locale } from '../../../../i18n/index';
import { getDesignData } from '../../../../lib/design-data';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const d = getDesignData(locale);
const n = d.newsletter;
const currentPath = getLocalePath(locale, '/design/content/newsletter/');
---

<DesignLayout
  locale={locale}
  currentPath={currentPath}
  seoTitle={n.seoTitle}
  seoDescription={n.seoDescription}
  group="content"
  title={n.title}
  intro={n.intro}
  toc={n.toc}
>
  <section id="design">
    <h2>{n.designHeading}</h2>
    <p set:html={md(n.designBody1)} />
    <p set:html={md(n.designBody2)} />
    <SpecimenCard label={n.mockLabel}>
      <!-- A static reconstruction of the email (the real thing is HTML mail,
           not a site component). Literal light-theme colours on purpose. -->
      <div class="ds-mail-stage" aria-hidden="true">
        <p class="ds-mail-subject"><span>{n.mockSubjectLabel}</span> {n.mockSubject}</p>
        <div class="ds-mail-card">
          <div class="ds-mail-accent"></div>
          <div class="ds-mail-brand"><span class="ds-mail-brand-b">&lt;&nbsp;</span><strong>w</strong>arrendeleon.com<span class="ds-mail-brand-b">&nbsp;/&gt;</span></div>
          <!-- The band is a generated image in the real email; this rebuilds it
               from the same ingredients: the post's real hero under the
               production overlay gradients (newsletter-card.html values). -->
          <div class="ds-mail-band">
            <span class="ds-mail-band-num">{n.mockBandPart}</span>
            <span class="ds-mail-band-rule"></span>
            <span class="ds-mail-band-text">
              <span class="ds-mail-band-series">{n.mockBandSeries}</span>
              <span class="ds-mail-band-title">{n.mockTitle}</span>
            </span>
          </div>
          <div class="ds-mail-content">
            <p class="ds-mail-eyebrow">{n.mockEyebrow}</p>
            <p class="ds-mail-title">{n.mockTitle}</p>
            <p class="ds-mail-desc">{n.mockDesc}</p>
            <p class="ds-mail-btn">{n.mockButton}</p>
            <p class="ds-mail-nav">{n.mockNav}</p>
          </div>
        </div>
      </div>
    </SpecimenCard>
  </section>

  <section id="why">
    <h2>{n.whyHeading}</h2>
    <p set:html={md(n.whyIntro)} />
    <ul class="ds-list">
      {n.whyReasons.map((r) => <li set:html={md(r)} />)}
    </ul>
    <p class="ds-sources">
      <span>{n.whySourcesLabel}:</span>
      {n.whySources.map((s, i) => (
        <>
          <a href={s.href} rel="noopener">{s.label}</a>{i < n.whySources.length - 1 && ' · '}
        </>
      ))}
    </p>
  </section>

  <section id="copy">
    <h2>{n.copyHeading}</h2>
    <p set:html={md(n.copyBody1)} />
    <ul class="ds-list">
      {n.copyRules.map((r) => <li set:html={md(r)} />)}
    </ul>
  </section>
</DesignLayout>

<style>
  .ds-sources {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--color-text-muted, #8a8a93);
  }
  .ds-sources span {
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.72rem;
    margin-right: 4px;
  }
  /* The email mock: the template's own literal values (600px card scaled to
     the column, #f5f5f7 ground, 4px lime accent, 14px corners, #5aa302 links,
     #4a8601 button). Light-fixed, as the prose explains. */
  .ds-mail-stage {
    width: 100%;
    max-width: 480px;
    background: #f5f5f7;
    border-radius: 10px;
    padding: 20px;
  }
  .ds-mail-subject {
    margin: 0 0 12px;
    font-size: 0.85rem;
    color: #0e0c19;
    font-weight: 600;
  }
  .ds-mail-subject span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #666666;
    margin-right: 6px;
  }
  .ds-mail-card {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 14px;
    overflow: hidden;
  }
  .ds-mail-accent { height: 4px; background: #6dc402; }
  .ds-mail-brand {
    padding: 14px 20px 12px;
    border-bottom: 1px solid #e0e0e0;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #0e0c19;
    font-size: 1rem;
  }
  .ds-mail-brand strong { font-weight: 800; }
  .ds-mail-brand-b { color: #6dc402; }
  /* Band mock: the post's real hero under the generator's own overlay values
     (newsletter-card.html: left-edge fade + left-to-right darkening), at the
     generator's 1200x400 proportions. */
  .ds-mail-band {
    display: flex;
    align-items: center;
    gap: 14px;
    aspect-ratio: 3 / 1;
    padding: 0 6.7%;
    background-image:
      linear-gradient(to left, rgba(10, 10, 16, 0.95) 0%, rgba(10, 10, 16, 0) 22%),
      linear-gradient(to right, rgba(10, 10, 16, 0.97) 0%, rgba(10, 10, 16, 0.86) 45%, rgba(10, 10, 16, 0.4) 100%),
      url('/images/blog/host-shell-federated-tabs-react-native.webp');
    background-size: cover;
    background-position: center 45%;
  }
  .ds-mail-band-num {
    font-size: clamp(2.4rem, 13vw, 4.2rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.028em;
    color: #6dc402;
    flex-shrink: 0;
  }
  .ds-mail-band-rule {
    width: 3px;
    height: 52%;
    border-radius: 2px;
    background: #6dc402;
    opacity: 0.9;
    flex-shrink: 0;
  }
  .ds-mail-band-text { display: flex; flex-direction: column; gap: 4px; max-width: 60%; }
  .ds-mail-band-series {
    font-size: clamp(0.5rem, 1.9vw, 0.62rem);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8fd640;
  }
  .ds-mail-band-title {
    font-size: clamp(0.7rem, 3vw, 1rem);
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: -0.01em;
    color: #ffffff;
  }
  .ds-mail-content { padding: 18px 20px; }
  .ds-mail-eyebrow {
    margin: 0 0 6px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5aa302;
  }
  .ds-mail-title {
    margin: 0 0 8px;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.2;
    color: #0e0c19;
  }
  .ds-mail-desc {
    margin: 0 0 14px;
    font-size: 0.88rem;
    line-height: 1.65;
    color: #444444;
  }
  .ds-mail-btn {
    display: inline-block;
    margin: 0 0 14px;
    background: #4a8601;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 11px 18px;
    border-radius: 10px;
  }
  .ds-mail-nav {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.6;
    color: #666666;
  }
</style>
