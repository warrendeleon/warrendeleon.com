---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/blog/Toc.astro';
import PageContents from '../../components/PageContents.astro';
import { t, getLocalePath, localeStaticPaths, type Locale } from '../../i18n/index';
import { SITE_URL, personRef } from '../../lib/person';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const i18n = t(locale);
const m = i18n.manual;

// The contents list and the sections it tracks are built from one array, so a
// section can never appear in the contents without existing on the page. It
// feeds the blog's own <Toc> on desktop and the same bottom sheet a post uses
// on mobile, via <PageContents>.
const sections = [
  { id: 'reach', label: m.routing.heading },
  { id: 'strengths', label: m.strengths.heading },
  { id: 'expectations', label: m.expectations.heading },
  { id: 'working', label: m.working.heading },
  { id: 'personality', label: m.personality.heading },
  { id: 'feedback', label: m.feedback.heading },
  { id: 'pressure', label: m.pressure.heading },
  { id: 'off-work', label: m.offWork.heading },
];

// UI marks reuse the outline set documented on /design/iconography/ (24px,
// currentColor, 2px round strokes). Slack is a brand mark, so it follows the
// SocialLinks convention instead: the real glyph, filled with currentColor so
// it stays monochrome and never introduces an off-system colour.
const ICONS: Record<string, { body: string; brand?: boolean }> = {
  slack: {
    brand: true,
    body: '<path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"></path>',
  },
  whatsapp: {
    brand: true,
    body: '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>',
  },
  phone: {
    body: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>',
  },
  oneToOne: {
    body: '<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline>',
  },
  calendar: {
    body: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>',
  },
  mail: {
    body: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline>',
  },
};

// Rows carry an optional href; only the ones pointing at a real page render as
// links, so "Slack" and "Email" stay plain text rather than dead anchors.
const rows = m.routing.rows.map((row) => {
  const target = 'channelHref' in row && row.channelHref ? row.channelHref : null;
  const external = !!target && /^https?:/.test(target);
  return {
    ...row,
    external,
    href: target ? (external ? target : getLocalePath(locale, target)) : null,
  };
});

const tocHeadings = sections.map((s) => ({ slug: s.id, text: s.label, depth: 2 }));

const jsonLd = {
  '@type': 'WebPage',
  '@id': `${SITE_URL}${getLocalePath(locale, '/manual-of-me/')}#webpage`,
  name: m.heading,
  description: i18n.seo.manualDescription,
  inLanguage: locale,
  about: personRef,
  author: personRef,
};
---

<BaseLayout
  title={i18n.seo.manualTitle}
  description={i18n.seo.manualDescription}
  locale={locale}
  currentPath={getLocalePath(locale, '/manual-of-me/')}
  jsonLd={jsonLd}
  isProfilePage
>
  <section class="section">
    <div class="container manual-hero">
      <div class="manual-hero-text">
        <h1 class="section-title">{m.heading}</h1>
        <p class="manual-lead">{m.lead}</p>
        <p class="manual-updated">{m.updated}</p>
      </div>
      <img
        src="/images/warren-deleon-headshot.webp"
        alt={m.portraitAlt}
        class="manual-portrait"
        width="843"
        height="843"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- The routing table is the page's one loud element: the situation is set
       large because that is what a reader scans for, and everything after this
       band stays quiet. -->
  <section class="section section-alt manual-section" id="reach">
    <div class="container">
      <h2 class="section-heading">{m.routing.heading}</h2>
      <p class="manual-intro">{m.routing.intro}</p>

      <div class="route-table">
        <div class="route-head" aria-hidden="true">
          <span>{m.routing.colNeed}</span>
          <span>{m.routing.colChannel}</span>
          <span>{m.routing.colReply}</span>
        </div>
        {rows.map((row) => (
          <div class="route-row">
            <div class="route-lead">
              <span class="route-icon" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill={ICONS[row.icon]?.brand ? 'currentColor' : 'none'}
                  stroke={ICONS[row.icon]?.brand ? 'none' : 'currentColor'}
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={ICONS[row.icon]?.body ?? ''}
                />
              </span>
              <p class="route-need">{row.need}</p>
            </div>
            <p class="route-channel">
              {row.href ? (
                <a
                  href={row.href}
                  target={row.external ? '_blank' : undefined}
                  rel={row.external ? 'noopener noreferrer' : undefined}
                >
                  {row.channel}
                </a>
              ) : (
                <span>{row.channel}</span>
              )}
              {'channelNote' in row && row.channelNote && (
                <span class="route-note">{row.channelNote}</span>
              )}
            </p>
            <p class="route-reply">
              <span class="route-reply-label">{m.routing.colReply}</span>
              {row.reply}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container manual-body">
      <div class="manual-contents">
        <Toc label={m.contents} headings={tocHeadings} />
      </div>

      <div class="manual-prose">
        <section id="strengths" class="manual-block manual-section">
          <h2 class="section-heading">{m.strengths.heading}</h2>
          <p>{m.strengths.intro}</p>
          <ul class="manual-list">
            {m.strengths.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section id="expectations" class="manual-block manual-section">
          <h2 class="section-heading">{m.expectations.heading}</h2>
          {m.expectations.paras.map((p) => <p>{p}</p>)}
        </section>

        <section id="working" class="manual-block manual-section">
          <h2 class="section-heading">{m.working.heading}</h2>
          <figure class="avail">
            <figcaption class="avail-caption">
              <span class="avail-label">{m.working.hoursLabel}</span>
              <span class="avail-value">{m.working.hoursValue}</span>
            </figcaption>

            <!-- The bar restates the caption above it, so it is hidden from
                 assistive tech rather than read out as a run of numbers. -->
            <div class="avail-chart" aria-hidden="true">
              <div class="avail-track">
                <div class="avail-core"><span>{m.working.core}</span></div>
                <div class="avail-triage"></div>
              </div>
              <div class="avail-scale">
                {['08:00', '10:00', '12:00', '14:00', '16:00', '18:00'].map((tick) => (
                  <span class="avail-tick">{tick}</span>
                ))}
              </div>
              <p class="avail-key">
                <span class="avail-swatch avail-swatch-triage"></span>
                {m.working.triage}
              </p>
            </div>
          </figure>
          {m.working.paras.map((p) => <p>{p}</p>)}
        </section>

        <section id="personality" class="manual-block manual-section">
          <h2 class="section-heading">{m.personality.heading}</h2>
          <p class="mbti">
            <span class="mbti-type">{m.personality.type}</span>
            <span class="mbti-note">{m.personality.typeNote}</span>
          </p>
          <p>{m.personality.body}</p>
          <p>
            <a href={m.personality.linkHref} target="_blank" rel="noopener noreferrer">
              {m.personality.linkLabel}
            </a>
          </p>
        </section>

        <section id="feedback" class="manual-block manual-section">
          <h2 class="section-heading">{m.feedback.heading}</h2>
          {m.feedback.paras.map((p) => <p>{p}</p>)}
        </section>

        <section id="pressure" class="manual-block manual-section">
          <h2 class="section-heading">{m.pressure.heading}</h2>
          {m.pressure.paras.map((p) => <p>{p}</p>)}
        </section>

        <section id="off-work" class="manual-block manual-section">
          <h2 class="section-heading">{m.offWork.heading}</h2>
          <div class="manual-off">
            <p>{m.offWork.para}</p>
            <img
              src="/images/photos/profile-09.webp"
              alt={m.offWork.photoAlt}
              class="manual-off-photo"
              width="1116"
              height="744"
              loading="lazy"
              decoding="async"
            />
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="wx-cta">
        <p class="wx-cta-heading">{m.cta.heading}</p>
        <p class="manual-cta-body">{m.cta.body}</p>
        <div class="wx-cta-actions">
          <a href={getLocalePath(locale, '/book-a-call/')} class="hero-cta hero-cta-solid">
            {m.cta.action}
          </a>
        </div>
      </div>
    </div>
  </section>
  <PageContents
    locale={locale}
    title={m.heading}
    toc={sections}
    sectionSelector=".manual-section"
    tocLinkSelector=".manual-contents [data-toc-link]"
  />
</BaseLayout>

<style>
  /* The container keeps the site's own width so the hero's left edge lines up
     with every section below it; only the measure of the copy is capped. The
     portraits are a single black-and-white series, so they carry the page's
     visual weight without adding a colour the design system doesn't have. */
  .manual-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
    align-items: center;
  }

  .manual-hero-text { max-width: 38rem; }

  /* Same headshot and same circular treatment as /about/, so the two pages
     read as one person rather than two shoots. */
  .manual-portrait {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 3px solid var(--border-color);
    box-shadow: var(--shadow);
  }

  .manual-off {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: 1.75rem;
    align-items: start;
  }

  .manual-off p { margin-bottom: 0; }

  .manual-off-photo {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-card);
  }

  .manual-lead {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0 0 1rem;
  }

  .manual-updated {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .manual-intro {
    max-width: 44rem;
    color: var(--text-secondary);
    margin: 0 0 2rem;
  }

  /* Routing table, drawn as a departures board rather than a grid of cards:
     the situation and the reply time are the two things a reader is scanning
     for, so both are set large and the row lights up as a single target. */
  .route-table {
    border-top: 1px solid var(--border-color);
    margin-top: 0.5rem;
  }

  .route-head,
  .route-row {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.8fr) minmax(0, 1.15fr);
    gap: 1.5rem;
    align-items: center;
  }

  .route-head {
    padding: 0.6rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-color);
  }

  .route-row {
    position: relative;
    padding: 1.5rem 1rem;
    border-bottom: 1px solid var(--border-color);
    border-radius: 10px;
    transition: background 0.2s ease;
  }

  /* The accent rail grows from the row's left edge on hover. It is the only
     motion on the page beyond the contents rail. */
  .route-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 2px;
    background: var(--color-green);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .route-row:hover { background: var(--bg-card); }
  .route-row:hover::before { transform: scaleY(1); }

  .route-lead {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }

  .route-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--color-green-text);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .route-row:hover .route-icon {
    background: var(--bg-secondary);
    border-color: var(--color-green);
  }

  .route-need {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  .route-channel {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .route-channel a { color: var(--color-green-text); }
  .route-channel a:hover { color: var(--color-green-text-hover); }

  .route-note {
    display: block;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  /* The reply time is the board's clock column: right-aligned, and set at
     reading size rather than as fine print, because it is half the answer. */
  .route-reply {
    margin: 0;
    text-align: right;
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .route-head span:last-child { text-align: right; }

  /* Every cell carries its own label so a screen reader always hears the
     column it belongs to; the visual column headings are decoration on top of
     that (hence aria-hidden). Clipped rather than display:none, or the label
     would be dropped from the accessibility tree along with the pixels. */
  .route-reply-label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Body follows the post layout: content left, contents pinned right from
     1024px, and below that the reading bar's bottom sheet carries them. */
  .manual-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .manual-contents { display: none; }

  @media (min-width: 1024px) {
    .manual-body {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 40px;
      /* No align-items: start — the contents cell must stretch to the row
         height or the sticky Toc has no room to travel. */
    }

    .manual-prose { grid-column: 1; grid-row: 1; }
    .manual-contents { display: block; grid-column: 2; grid-row: 1; }
  }

  .manual-prose { max-width: 40rem; }

  .manual-block + .manual-block { margin-top: 3rem; }

  .manual-block p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-secondary);
    margin: 0 0 1rem;
  }

  .manual-block .section-heading { scroll-margin-top: 6rem; }

  .manual-sub {
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem;
  }

  .manual-list {
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    color: var(--text-secondary);
  }

  .manual-list li {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    margin-bottom: 0.5rem;
  }

  .manual-list li::marker { color: var(--color-green); }

  /* Availability. The working day drawn to scale across an 08:00-19:00 track,
     so "when can I catch him" is answered by looking rather than by reading.
     Offsets are minutes-from-08:00 over the 660-minute span: 09:00 lands at
     9.09%, 09:30 at 13.64%, 17:30 at 86.36%. */
  .avail {
    margin: 0 0 2rem;
    padding: 1.1rem 1.2rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
  }

  .avail-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .avail-label { font-size: 0.85rem; color: var(--text-muted); }

  .avail-value {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .avail-track {
    position: relative;
    height: 40px;
    border-radius: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    overflow: hidden;
  }

  .avail-core {
    position: absolute;
    inset-block: 0;
    left: 9.09%;
    width: 77.27%;
    display: flex;
    align-items: center;
    padding-left: 0.7rem;
    background: var(--color-green);
    color: var(--color-on-green);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .avail-core span {
    position: relative;
    z-index: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The first half hour goes on triage, so it is marked off inside the band
     rather than drawn as a second bar. */
  .avail-triage {
    position: absolute;
    inset-block: 0;
    left: 9.09%;
    width: 4.55%;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-green-dark) 0 3px,
      transparent 3px 6px
    );
  }

  .avail-scale {
    display: flex;
    justify-content: space-between;
    margin-top: 0.4rem;
  }

  .avail-tick { font-size: 0.72rem; color: var(--text-muted); }

  .avail-key {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.7rem 0 0 !important;
    font-size: 0.8rem !important;
    color: var(--text-muted) !important;
  }

  .avail-swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .avail-swatch-triage {
    background: repeating-linear-gradient(
      -45deg,
      var(--color-green-dark) 0 3px,
      var(--color-green) 3px 6px
    );
  }

  /* The type code carries the weight; the gloss beside it stays quiet, so the
     block reads as one line rather than a badge with a caption. */
  .mbti {
