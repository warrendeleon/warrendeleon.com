    try {
      const LONDON = 'Europe/London';
      const lang = nowOut.dataset.locale || 'en-GB';
      const parts = (d: Date, tz: string) => {
        const p = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', weekday: 'short' }).formatToParts(d);
        const get = (t: string) => p.find((x) => x.type === t)?.value ?? '';
        return { y: +get('year'), m: +get('month'), d: +get('day'), h: +get('hour'), min: +get('minute'), wd: get('weekday') };
      };
      const londonInstant = (y: number, m: number, d: number, h: number, min: number) => {
        let t = Date.UTC(y, m - 1, d, h, min);
        for (let i = 0; i < 2; i++) {
          const q = parts(new Date(t), LONDON);
          t += Date.UTC(y, m - 1, d, h, min) - Date.UTC(q.y, q.m - 1, q.d, q.h, q.min);
        }
        return new Date(t);
      };
      const nowL = parts(new Date(), LONDON);
      const probe = new Date(Date.UTC(nowL.y, nowL.m - 1, nowL.d, 12));
      const dow = probe.getUTCDay();
      probe.setUTCDate(probe.getUTCDate() + (dow === 6 ? 2 : dow === 0 ? 1 : 0));
      const day = { y: probe.getUTCFullYear(), m: probe.getUTCMonth() + 1, d: probe.getUTCDate() };
      const start = londonInstant(day.y, day.m, day.d, 9, 0);
      const end = londonInstant(day.y, day.m, day.d, 17, 30);

      // Where the reader is, if the browser will say.
      let zone = '';
      try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch { zone = ''; }
      const zoneKnown = !!zone && !/^(UTC|GMT|Etc\/)/i.test(zone);
      const time = new Intl.DateTimeFormat('en-GB', { timeZone: zoneKnown ? zone : LONDON, hourCycle: 'h23', hour: '2-digit', minute: '2-digit' });
      const onUkTime = zoneKnown && time.format(start) === '09:00' && time.format(end) === '17:30' && parts(start, zone).d === parts(start, LONDON).d;

      // 1. The hours line loses its qualifier for a reader on UK time.
      if (onUkTime && hoursOut?.dataset.here) hoursOut.textContent = hoursOut.dataset.here;

      // 2. The UK clock, live, refreshed on the minute; from London's zone, so
      //    it is right even in a browser that hides its own.
      const clock = new Intl.DateTimeFormat('en-GB', { timeZone: LONDON, hourCycle: 'h23', hour: '2-digit', minute: '2-digit' });
      const dayName = new Intl.DateTimeFormat(lang, { timeZone: LONDON, weekday: 'long' });
      const paint = () => {
        const now = new Date();
        const hm = clock.format(now);
        const wd = parts(now, LONDON).wd;
        const minutes = Number(hm.slice(0, 2)) * 60 + Number(hm.slice(3, 5));
        const working = !['Sat', 'Sun'].includes(wd) && minutes >= 9 * 60 && minutes < 17 * 60 + 30;
        const d = nowOut.dataset;
        const tpl = (onUkTime ? (working ? d.tplInHere : d.tplOutHere) : (working ? d.tplIn : d.tplOut)) || '';
        nowOut.textContent = tpl.replace('{time}', hm).replace('{day}', dayName.format(now));
        nowOut.hidden = false;
      };
      paint();
      const tick = () => { paint(); window.setTimeout(tick, 60000 - (Date.now() % 60000)); };
      window.setTimeout(tick, 60000 - (Date.now() % 60000));
      document.addEventListener('visibilitychange', () => { if (!document.hidden) paint(); });

      // 3. Readers elsewhere get the hours in their zone, with the end day
      //    only when it differs, and a local hour under each tick.
      if (zoneKnown && !onUkTime) {
        const weekday = new Intl.DateTimeFormat(lang, { timeZone: zone, weekday: 'long' });
        const sd = parts(start, zone), ed = parts(end, zone);
        const same = sd.y === ed.y && sd.m === ed.m && sd.d === ed.d;
        const tpl = same ? (localOut.dataset.lineSame || '') : (localOut.dataset.line || '');
        // The zone's generic name in the page's language; the city from the
        // identifier if the runtime cannot produce one (Chrome reports Kolkata
        // as "Calcutta") or produces a malformed one (Filipino's "HIlagang").
        let zoneName = zone.split('/').pop()!.replace(/_/g, ' ');
        try {
          const named = new Intl.DateTimeFormat(lang, { timeZone: zone, timeZoneName: 'longGeneric' }).formatToParts(start).find((x) => x.type === 'timeZoneName')?.value;
          if (named && !/^GMT|^UTC/.test(named) && !/[A-Z]{2}[a-z]/.test(named)) zoneName = named;
        } catch { /* older runtime: keep the city */ }
        localOut.textContent = tpl
          .replace('{zone}', zoneName)
          .replace('{startDay}', weekday.format(start))
          .replace('{start}', time.format(start))
          .replace('{endDay}', weekday.format(end))
          .replace('{end}', time.format(end));
        localOut.hidden = false;
        const shortDay = new Intl.DateTimeFormat(lang, { timeZone: zone, weekday: 'short' });
        const first = parts(londonInstant(day.y, day.m, day.d, 8, 0), zone);
        document.querySelectorAll<HTMLElement>('.avail-tick').forEach((tickEl) => {
          const at = londonInstant(day.y, day.m, day.d, Number(tickEl.dataset.hour), 0);
          const local = tickEl.querySelector<HTMLElement>('.avail-tick-local');
          if (!local) return;
          const lp = parts(at, zone);
          local.textContent = time.format(at);
          if (lp.d !== first.d || lp.m !== first.m) {
            const tag = document.createElement('span');
            tag.className = 'avail-tick-day';
            tag.textContent = shortDay.format(at).replace(/\.$/, '');
            local.appendChild(tag);
          }
          local.hidden = false;
        });
        document.querySelector('.avail-scale')?.classList.add('has-local');
      }
    } catch {
      // No Intl, or a zone the runtime cannot name: the page reads as served.
    }
  }

  // The title assembles like the board, once, when the page opens.
  const title = document.querySelector<HTMLElement>('.cover-title');
  if (title) window.setTimeout(() => flap(title), 350);

  // Departures board: rows flap in once, the first time it scrolls into view.
  // Armed only when the observer exists, so no-JS and old browsers just see
  // the rows.
  const board = document.querySelector<HTMLElement>('[data-board]');
  if (board && 'IntersectionObserver' in window) {
    board.classList.add('is-armed');
    let done = false;
    const go = () => {
      if (done) return;
      done = true;
      board.classList.add('is-live');
      io.disconnect();
      board.querySelectorAll<HTMLElement>('.board-time .board-flap').forEach((el, i) => window.setTimeout(() => flap(el), 250 + i * 90));
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) go();
    }, { threshold: 0.15 });
    io.observe(board);
    // Whatever happens to the observer (a hidden tab, a print preview), the
    // rows must never stay hidden: flap them in unprompted after a beat.
    window.setTimeout(go, 2500);
  }
</script>
