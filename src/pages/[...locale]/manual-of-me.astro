<script>

  // Solari flap: each reply settles character by character, like a real
  // split-flap board, once when the board comes into view and again on
  // hover. Skipped entirely under reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const DIGIT = '0123456789';
  const pool = (ch: string) => (/[0-9]/.test(ch) ? DIGIT : ch === ch.toUpperCase() ? UPPER : LOWER);
  // Driven by wall-clock time with a hard 650ms deadline, so a throttled or
  // hidden tab can never leave the reply as scrambled text: any tick that
  // lands past the deadline restores the real value at once.
  const flap = (el: HTMLElement) => {
    if (reduce || document.hidden) return;
    const target = el.dataset.flap ?? el.textContent ?? '';
    const start = performance.now();
    const DURATION = el.classList.contains('cover-title') ? 1100 : 650;
    const tick = () => {
      const t = (performance.now() - start) / DURATION;
      if (t >= 1 || document.hidden) { el.textContent = target; return; }
      el.textContent = Array.from(target, (ch, i) => {
        if (!/[A-Za-z0-9]/.test(ch)) return ch;
        const settle = 0.25 + (i / target.length) * 0.65;
        if (t >= settle) return ch;
        const p = pool(ch);
        return p[Math.floor(Math.random() * p.length)];
      }).join('');
      window.setTimeout(tick, 36);
    };
    tick();
  };
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) return;
    document.querySelectorAll<HTMLElement>('.board-flap').forEach((el) => { el.textContent = el.dataset.flap ?? el.textContent; });
  });

  // Chapter list: the current chapter is the last one whose top has passed
  // the reading line (40% down the viewport), or the last chapter once the
  // page is scrolled to its end. Computed from positions on every scroll
  // frame rather than from intersection events, so it cannot be left behind
  // by a long chapter. Without script the links simply work.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.jump-link'));
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('.manual-section[id]'));
  const currentOut = document.querySelector<HTMLElement>('[data-jump-current]');
  const menu = document.querySelector<HTMLDetailsElement>('details.jump');
  if (links.length && chapters.length) {
    let last = '';
    const setCurrent = (id: string) => {
      if (id === last) return;
      last = id;
      links.forEach((a) => {
        const on = a.dataset.target === id;
        a.classList.toggle('is-current', on);
        if (on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
      });
      if (currentOut) {
        // The label comes from the list itself, so the summary and the menu
        // can never disagree, and the numeral is not read twice.
        const src = links.find((a) => a.dataset.target === id);
        const num = currentOut.querySelector('.jump-current-num');
        const label = currentOut.querySelector('.jump-current-label');
        if (num) num.textContent = src?.querySelector('.jump-num')?.textContent ?? '';
        if (label) label.textContent = src?.querySelector('.jump-label')?.textContent ?? '';
        currentOut.classList.toggle('is-empty', !id);
