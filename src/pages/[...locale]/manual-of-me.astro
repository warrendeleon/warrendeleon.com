---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { md } from '../../lib/inline-markup';
import { t, getLocalePath, localeStaticPaths, locales, localeNames, type Locale } from '../../i18n/index';
import { SITE_URL, personRef } from '../../lib/person';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const i18n = t(locale);
const m = i18n.manual;

// One list drives the desktop Toc, the mobile sheet and the chapter numerals,
// so a chapter cannot appear in the contents without existing on the page.
const sections = [
  { id: 'reach', label: m.routing.heading },
  { id: 'off-work', label: m.offWork.heading },
  { id: 'howto', label: m.howTo.heading },
  { id: 'working', label: m.working.heading },
  { id: 'feedback', label: m.feedback.heading },
  { id: 'personality', label: m.personality.heading },
];
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');

// Ring gauges for the locus block. One circle of radius 44 in a 100-unit box;
// the arc is a dash of the circumference, rotated so 0% starts at twelve
// o'clock. Only the locus scores get rings: they are independent 0–100
// quantities. The five trait scales stay as two-ended bars because each one is
// bipolar (56% Extraverted is also 44% Introverted) and a ring would hide that.
// Percent typography follows the edition: Spanish and Catalan set a non-breaking
// space before the sign (56 %), English and Tagalog close it up (56%).
const pctGap = locale === 'es' || locale === 'ca' ? '\u00a0' : '';

const RING_R = 44;
const RING_C = 2 * Math.PI * RING_R;

// UI marks reuse the outline set documented on /design/iconography/. Slack and
// WhatsApp are brand marks, so they follow the SocialLinks convention instead:
// the real glyph, filled with currentColor, never a brand colour.
const ICONS: Record<string, { body: string; brand?: boolean }> = {
  slack: { brand: true, body: '<path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"></path>' },
  whatsapp: { brand: true, body: '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>' },
  oneToOne: { body: '<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline>' },
  calendar: { body: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>' },
  mail: { body: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline>' },
};

// Only rows pointing at a real page become links; "Slack" and "Email" stay
// plain text. An off-site href must not be run through getLocalePath.
const rows = m.routing.rows.map((row) => {
  const target = 'channelHref' in row && row.channelHref ? row.channelHref : null;
  const external = !!target && /^https?:/.test(target);
  return { ...row, external, href: target ? (external ? target : getLocalePath(locale, target)) : null };
});

// Copy strings carry [text](/path) links; site-relative ones are localised
// here so /blog/ becomes /es/blog/ on the Spanish page.
const rich = (text: string) =>
  md(text).replace(/href="(\/[^"]*)"/g, (_, path: string) => `href="${getLocalePath(locale, path)}"`);

const jsonLd = {
  '@type': 'WebPage',
  '@id': `${SITE_URL}${getLocalePath(locale, '/manual-of-me/')}#webpage`,
  name: m.heading,
  description: i18n.seo.manualDescription,
  inLanguage: locale,
  about: personRef,
  author: personRef,
};
---

<BaseLayout
  title={i18n.seo.manualTitle}
  description={i18n.seo.manualDescription}
  locale={locale}
  currentPath={getLocalePath(locale, '/manual-of-me/')}
  jsonLd={jsonLd}
  isProfilePage
  preloadImage="/images/photos/profile-11.webp"
  chrome={false}
>
  <!-- Cover. A white wall with hard sunlight, so the cover is light in both
       themes and the title sits in the empty left of the frame. -->
  <header class="cover" id="top">
    <!-- The blog hero's treatment: the same photo blurred behind, sharp copy
         at the container width in front, so a wide screen shows more wall
         rather than a tighter crop of the face. -->
    <div class="cover-bg" aria-hidden="true"></div>
    <div class="cover-frame">
      <img
        src="/images/photos/profile-11.webp"
        alt={m.cover.photoAlt}
        class="cover-photo"
        width="1248"
        height="832"
        fetchpriority="high"
        decoding="async"
      />
      <div class="cover-shade" aria-hidden="true"></div>
      <div class="cover-text">
        <p class="cover-edition">
          <span>{m.cover.edition}</span>
          <span class="cover-dot" aria-hidden="true"></span>
          <span>{m.cover.date}</span>
        </p>
        <h1 class="cover-title board-flap" data-flap={m.heading}>{m.heading}</h1>
        <p class="cover-tagline">{m.cover.tagline}</p>
      </div>
    </div>
  </header>

  <!-- Spec plate. A person described the way a product is, which is the joke
       the title already makes. The toggle is the one interaction on the page:
       every value on the right is true; every value on the left is 09:00. -->
  <div class="sheet">
  <section class="section section-alt">
    <div class="container">
      <div class="spec">
        <div class="spec-head">
          <div>
            <h2 class="spec-title">{m.spec.heading}</h2>
            <p class="spec-note">{m.spec.note}</p>
          </div>
          <nav class="seg" aria-label={i18n.a11y.selectLanguage}>
            {locales.map((l) => (
              l === locale
                ? <span class="seg-btn is-current" aria-current="page" lang={l}>{localeNames[l]}</span>
                : <a class="seg-btn" href={getLocalePath(l, '/manual-of-me/')} hreflang={l} lang={l}>{localeNames[l]}</a>
            ))}
          </nav>
        </div>
        <dl class="spec-list">
          {m.spec.rows.map(([k, after]) => (
            <div class="spec-row">
              <dt>{k}</dt>
              <dd><span class="board-flap" data-flap={after}>{after}</span></dd>
            </div>
          ))}
          <!-- The languages row is a specification, not a switch: the segmented
               control above and the colophon below already switch editions,
               and a third set of links here was one too many. -->
          <div class="spec-row">
            <dt>{m.spec.languagesLabel}</dt>
            <dd>
              <span class="spec-langs">
                {locales.map((l, i) => (
                  <>
                    {i > 0 && <><span class="spec-sep" aria-hidden="true">·</span>{' '}</>}
                    <span lang={l}>{localeNames[l]}</span>
                  </>
                ))}
              </span>
            </dd>
          </div>
          <div class="spec-row">
            <dt>{m.spec.historyLabel}</dt>
            <dd>
              <span set:html={rich(m.spec.historyAfter)} />
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Chapter list, twice: this bar sticks to the top on phones and tablets,
       and the same list is the rail beside the manual on desktop. One data
       source (sections), so neither can drift from the page. -->
  <details class="jump">
    <summary class="jump-summary">
      <span class="container jump-summary-inner">
        <span class="jump-title">{m.contents}</span>
        <span class="jump-current" data-jump-current><span class="jump-current-num jump-num" aria-hidden="true"></span><span class="jump-current-label"></span></span>
        <span class="jump-caret" aria-hidden="true"></span>
      </span>
    </summary>
    <nav class="jump-list" aria-label={m.contents}>
      <div class="container">
        {sections.map((sec, i) => (
          <a href={`#${sec.id}`} class="jump-link" data-target={sec.id}>
            <span class="jump-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="jump-label">{sec.label}</span>
          </a>
        ))}
      </div>
    </nav>
  </details>

  <!-- Departures board. The reply column is the clock, the channel is the
       gate, and the rows flap in once when the board comes into view. -->
  <section class="section manual-section" id="reach">
    <div class="container">
      <h2 class="section-heading chapter"><span class="chapter-num" aria-hidden="true">{num('reach')}</span>{m.routing.heading}</h2>
      <p class="chapter-sub">{m.routing.sub}</p>
      <div class="board" data-board>
        <div class="board-head" aria-hidden="true">
          <span>{m.routing.colNeed}</span>
          <span>{m.routing.colChannel}</span>
          <span>{m.routing.colReply}</span>
        </div>
        {rows.map((row, i) => (
          <div class="board-row" style={`--i:${i}`}>
            <div class="board-lead">
              <span class="board-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24"
                  fill={ICONS[row.icon]?.brand ? 'currentColor' : 'none'}
                  stroke={ICONS[row.icon]?.brand ? 'none' : 'currentColor'}
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  set:html={ICONS[row.icon]?.body ?? ''} />
              </span>
              <p class="board-need">{row.need}</p>
            </div>
            <p class="board-gate">
              {row.href ? (
                <a href={row.href} target={row.external ? '_blank' : undefined} rel={row.external ? 'noopener noreferrer' : undefined}>{row.channel}</a>
              ) : (
                <span>{row.channel}</span>
              )}
              {'channelNote' in row && row.channelNote && <span class="board-note">{row.channelNote}</span>}
            </p>
            <p class="board-time" id={`board-time-${i}`}>
              <span class="board-time-label">{m.routing.colReply}</span>
              <span class="board-flap" data-flap={row.reply}>{row.reply}</span>
            </p>
          </div>
        ))}
      </div>
      <p class="fig"><span class="fig-label">{m.figures.label} 1</span><span class="fig-caption">{m.figures.board}</span></p>
    </div>
  </section>

  <!-- Off the clock. The one loud band on the page: the brand green as a
       ground rather than an accent, the jumper photo, and the things you can
       always open a conversation with. It sits high because it is the point. -->
  <section class="offclock manual-section" id="off-work">
    <div class="container offclock-inner">
      <div class="offclock-text">
        <h2 class="offclock-title"><span class="chapter-num" aria-hidden="true">{num('off-work')}</span>{m.offWork.heading}</h2>
        <p class="offclock-sub">{m.offWork.sub}</p>
        <p set:html={rich(m.offWork.para)} />
        <p class="offclock-asks">{m.offWork.asksHead}</p>
        <p class="offclock-topics">
          {m.offWork.asks.map((x, i) => (
            <><span class="offclock-topic">{x}</span>{i < m.offWork.asks.length - 1 && <>&nbsp;<span class="offclock-sep" aria-hidden="true">·</span>{' '}</>}</>
          ))}
        </p>
        <p class="offclock-asks">{m.offWork.socialLabel}</p>
        <SocialLinks locale={locale} size={22} />
      </div>
      <img src="/images/photos/offclock-tulips.webp" alt={m.offWork.photoAlt} class="offclock-photo" width="1200" height="1500" decoding="async" />
    </div>
  </section>

  <!-- The manual proper. From here the page is a documentation grid: a rail
       on the left with the numeral, heading, deck and provenance, and a body
       column on the right at a reading measure, wide enough for the objects
       (chart, bars, rings) to sit in it. The rail is sticky on desktop so the
       chapter name stays in view while its content scrolls. -->
  <section class="section manual-grid">
    <div class="container manual-layout">
      <nav class="contents" aria-label={m.contents}>
        {sections.map((sec, i) => (
        <a href={`#${sec.id}`} class="jump-link" data-target={sec.id}>
          <span class="jump-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="jump-label">{sec.label}</span>
        </a>
        ))}
      </nav>
      <div class="manual-prose">
        <section id="howto" class="manual-block manual-section">
          <div class="chapter-head">
            <h2 class="section-heading chapter"><span class="chapter-num" aria-hidden="true">{num('howto')}</span>{m.howTo.heading}</h2>
            <p class="chapter-sub">{m.howTo.sub}</p>
          </div>
          <div class="chapter-body">
            <div class="hd">
              <div class="hd-col">
                <p class="hd-head">{m.howTo.helpsHead}</p>
                <ul class="hd-list hd-yes">{m.howTo.helps.map((x) => <li>{x}</li>)}</ul>
              </div>
              <div class="hd-col">
                <p class="hd-head">{m.howTo.hurtsHead}</p>
                <ul class="hd-list hd-no">{m.howTo.hurts.map((x) => <li>{x}</li>)}</ul>
              </div>
            </div>
          </div>
        </section>

        <section id="working" class="manual-block manual-section">
          <div class="chapter-head">
            <h2 class="section-heading chapter"><span class="chapter-num" aria-hidden="true">{num('working')}</span>{m.working.heading}</h2>
            <p class="chapter-sub">{m.working.sub}</p>
          </div>
          <div class="chapter-body">
            <figure class="avail">
              <figcaption class="avail-caption">
                <span class="avail-label">{m.working.hoursLabel}</span>
                <span class="avail-value" data-avail-hours data-here={m.working.hoursValueHere}>{m.working.hoursValue}</span>
                <span class="avail-now" data-avail-now data-tpl-in={m.working.nowIn} data-tpl-out={m.working.nowOut} data-tpl-in-here={m.working.nowInHere} data-tpl-out-here={m.working.nowOutHere} data-locale={locale === 'tl' ? 'fil' : locale} hidden></span>
                <span class="avail-local" data-avail-local data-line={m.working.localLine} data-line-same={m.working.localLineSameDay} data-locale={locale === 'tl' ? 'fil' : locale} hidden></span>
              </figcaption>
              <div class="avail-chart" aria-hidden="true">
                <div class="avail-track">
                  <div class="avail-core"><span>{m.working.core}</span></div>
                  <div class="avail-triage"></div>
                </div>
                <div class="avail-scale">
                  {['08:00', '10:00', '12:00', '14:00', '16:00', '18:00'].map((tick, i) => (
                    <span class="avail-tick" style={`--t:${i}`} data-hour={8 + i * 2}>{tick}<span class="avail-tick-local" hidden></span></span>
                  ))}
                </div>
                <p class="avail-key"><span class="avail-swatch"></span>{m.working.triage}</p>
              </div>
            </figure>
            <p class="fig"><span class="fig-label">{m.figures.label} 2</span><span class="fig-caption">{m.figures.hours}</span></p>
            {m.working.paras.map((p) => <p>{p}</p>)}
          </div>
        </section>

        <section id="feedback" class="manual-block manual-section">
          <div class="chapter-head">
            <h2 class="section-heading chapter"><span class="chapter-num" aria-hidden="true">{num('feedback')}</span>{m.feedback.heading}</h2>
            <p class="chapter-sub">{m.feedback.sub}</p>
          </div>
          <div class="chapter-body">
            {m.feedback.paras.map((p) => <p>{p}</p>)}
          </div>
        </section>

        <section id="personality" class="manual-block manual-section" data-reveal>
          <div class="chapter-head">
            <h2 class="section-heading chapter"><span class="chapter-num" aria-hidden="true">{num('personality')}</span>{m.personality.heading}</h2>
            <p class="chapter-sub">{m.personality.sub}</p>
            <p class="source-note">{m.personality.source}</p>
          </div>
          <div class="chapter-body">
            <h3 class="sub-heading sub-heading--first">{m.personality.agreeHeading}</h3>
            <p class="source-note">{m.personality.agreeSource}</p>
            <ul class="agree" role="list">
              {m.personality.agree.map((a) => (
                <li class="agree-item">
                  <p class="agree-claim">{a.claim}</p>
                  <p class="agree-means">{a.means}</p>
                  <ul class="agree-evidence" role="list">
                    {a.evidence.map((e) => (
                      <li><span class="agree-src">{e.source}</span>{e.detail}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>

            <h3 class="sub-heading">{m.personality.typeName}</h3>
            <div class="mbti" role="img" aria-label={`${m.personality.typeName}: ${m.personality.letters.map(([, w]) => w).join(', ')}`}>
              {m.personality.letters.map(([letter, word]) => (
                <span class="mbti-letter">
                  <span class="mbti-big">{letter}</span>
                  <span class="mbti-word">{word}</span>
                </span>
              ))}
            </div>
            <p class="type-note">{m.personality.typeNote}</p>

            <ul class="traits" role="list">
              {m.personality.traits.map((t) => (
                <li class="trait">
                  <span class="trait-dim">{t.dim}</span>
                  <span class="trait-score"><strong>{t.value}{pctGap}%</strong> {t.label}</span>
                  <span class="trait-track" aria-hidden="true">
                    <span class="trait-fill" style={`--v:${t.value}%`}></span>
                  </span>
                  <span class="trait-poles" aria-hidden="true">
                    <span>{t.label}</span><span>{t.opposite}</span>
                  </span>
                </li>
              ))}
            </ul>
            <p class="fig"><span class="fig-label">{m.figures.label} 3</span><span class="fig-caption">{m.figures.traits}</span></p>
            <p class="scale-note">{m.personality.traitsNote}</p>


            <h3 class="sub-heading">{m.personality.locusHeading}</h3>
            <p class="source-note">{m.personality.locusSource}</p>
            <ul class="rings" role="list">
              {m.personality.locus.map((l) => (
                <li class="ring-item">
                  <span class="ring">
                    <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
                      <circle class="ring-track" cx="50" cy="50" r={RING_R} />
                      <circle class="ring-arc" cx="50" cy="50" r={RING_R} style={`--arc:${(l.value / 100) * RING_C}; --c:${RING_C}`} transform="rotate(-90 50 50)" />
                    </svg>
                    <span class="ring-num"><span class="ring-val">{l.value}{pctGap}<small>%</small></span></span>
                  </span>
                  <span class="ring-label">{l.label}</span>
                </li>
              ))}
            </ul>
            <p class="fig"><span class="fig-label">{m.figures.label} 4</span><span class="fig-caption">{m.figures.locus}</span></p>
            <p class="scale-note">{m.personality.locusNote}</p>
            <p class="type-link"><a href={m.personality.linkHref} target="_blank" rel="noopener noreferrer">{m.personality.linkLabel}</a></p>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Colophon. The page opened on a cover; it should not stop dead on a link.
       The board's dark ground returns here so the two dark objects bookend the
       sheet, carrying the edition line, the other three editions, the way
       home and the way back up. -->
  <footer class="colophon">
    <div class="container colophon-inner">
      <div class="colophon-left">
        <p class="colophon-title">{m.heading}</p>
        <p class="colophon-note">{m.colophon.note}</p>
      </div>
      <div class="colophon-right">
        <p class="colophon-langs">
          <span class="colophon-label">{m.colophon.languages}</span>
          {locales.map((l) => (
            l === locale
              ? <span class="colophon-lang is-current" aria-current="page" lang={l}>{localeNames[l]}</span>
              : <a class="colophon-lang" href={getLocalePath(l, '/manual-of-me/')} hreflang={l} lang={l}>{localeNames[l]}</a>
          ))}
        </p>
        <p class="colophon-links">
          <a href={getLocalePath(locale, '/')}>{m.colophon.home}</a>
          <a href="#top" class="colophon-top">{m.colophon.top} <span aria-hidden="true">↑</span></a>
        </p>
      </div>
    </div>
  </footer>
  </div>
</BaseLayout>

<style is:global>
  /* Bricolage Grotesque, variable (wght 200–800, opsz 12–96), OFL, self-hosted
     like Inter. Only this page uses it: a display face with a bit of
     character is what turns the poster from generic to personal. */
  @font-face {
    font-family: 'Bricolage Grotesque';
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url('/fonts/bricolage-grotesque-latin-var.woff2') format('woff2-variations'), url('/fonts/bricolage-grotesque-latin-var.woff2') format('woff2');
  }
  /* This page is a poster on the wall colour of the photograph, in both
     themes; the board is the one dark object on it. */
  html, body { background: #f4f4f2 !important; color-scheme: light; }
</style>

<style>
  /* ============ Cover ==============================================
     The photograph keeps its own 3:2 shape inside a centred frame, so a wide
     screen gets a card on the wall colour rather than a letterbox crop of the
     face, and the 1248px source is never scaled up. Phones crop to the face. */
  .cover {
    position: sticky;
    top: 0;
    z-index: 0;
    overflow: hidden;
    /* Pinned: a white wall, so the cover is light in both themes. */
    background: #f4f4f2;
    color: #0e0c19;
  }

  .cover-bg {
    position: absolute;
    inset: -60px;
    background-image: url('/images/photos/profile-11.webp');
    background-size: cover;
    background-position: center 30%;
    filter: blur(24px) brightness(0.92);
    z-index: 0;
  }

  .cover-frame {
    position: relative;
    z-index: 1;
    max-width: 1100px; /* the site container */
    margin: 0 auto;
    overflow: hidden;
  }

  .cover-photo {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(92vh, 960px);
    object-fit: cover;
    object-position: 50% 30%;
    animation: cover-settle 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .cover-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(244, 244, 242, 0.92) 0%, rgba(244, 244, 242, 0.55) 26%, transparent 58%);
  }

  .cover-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 clamp(1.25rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem);
  }

  .cover-edition,
  .cover-title,
  .cover-tagline {
    animation: cover-rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .cover-title { animation-delay: 0.12s; }
  .cover-tagline { animation-delay: 0.24s; }

  .cover-edition {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #427401; /* the light theme's --color-green-text, pinned with the ground */
  }

  .cover-dot { width: 5px; height: 5px; border-radius: 50%; background: #6dc402; }

  .cover-title {
    margin: 0;
    font-family: 'Bricolage Grotesque', Inter, system-ui, sans-serif;
    font-optical-sizing: auto;
    font-size: clamp(3.4rem, 11vw, 8.5rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: #0e0c19;
  }


  .cover-tagline {
    margin: 1.1rem 0 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #3d3d3d;
  }

  @keyframes cover-rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @keyframes cover-settle { from { transform: scale(1.06); } to { transform: none; } }

  /* The page body is a sheet that slides up over the pinned cover. */
  .sheet {
    position: relative;
    z-index: 1;
    /* Pinned light tokens: every site component inside (spec plate, chart,
       chips, socials) follows these instead of the dark theme. */
    --bg-primary: #f4f4f2;
    --bg-secondary: #eae9e5;
    --bg-card: #ffffff;
    --text-primary: #0e0c19;
    --text-secondary: #3a3a3a;
    --text-muted: #6d6d6a;
    --border-color: #d6d5cf;
    --badge-bg: #ffffff;
    --badge-text: #0e0c19;
    --color-green-text: #427401;
    --color-green-text-hover: #365e01;
    --shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    --shadow-card: 0 2px 8px rgba(0, 0, 0, 0.06);
    --shadow-lift: 0 18px 48px rgba(14, 12, 25, 0.22);
    background: var(--bg-primary);
    color: var(--text-primary);
    box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.18);
  }
  .sheet :global(.section-alt) { background: var(--bg-secondary); border-color: var(--border-color); }
  .sheet :global(.section-heading) { color: var(--text-primary); }

  /* ============ Spec plate ========================================== */
  .spec-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 2rem;
    margin-bottom: 1.25rem;
  }

  .spec-title {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .spec-note { margin: 0.35rem 0 0; font-size: 0.92rem; color: var(--text-secondary); }

  /* Language switch, in the segmented-pill form the spec plate wears. */
  .seg {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
  }

  .seg-btn {
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  a.seg-btn:hover { background: var(--bg-secondary); color: var(--text-primary); }
  .seg-btn.is-current { background: var(--color-green); color: var(--color-on-green); }

  .spec-list {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    border-top: 1px solid var(--border-color);
  }

  @media (min-width: 700px) {
    .spec-list { grid-template-columns: 1fr 1fr; column-gap: 3rem; }
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .spec-row dt { font-size: 0.76rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }

  .spec-row dd {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-primary);
    perspective: 400px;
  }

  .spec-row dd > span { display: block; }
  .spec-langs > * { display: inline; }

  .spec-lead {
    max-width: 44rem;
    margin: 1.5rem 0 0;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* ============ Chapters ============================================= */
  /* A manual's contents genuinely is a sequence, so the numeral carries
     information. Kept inline so .section-heading's ::after bar stays below. */
  .chapter {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.9rem;
    align-items: baseline;
    font-family: 'Bricolage Grotesque', Inter, system-ui, sans-serif;
    font-optical-sizing: auto;
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    letter-spacing: -0.02em;
  }
  .chapter::after { grid-column: 2; }
  .chapter-num {
    font-family: 'Bricolage Grotesque', Inter, system-ui, sans-serif;
    font-size: 0.55em;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-green-text);
    align-self: baseline;
  }
  .chapter-sub {
    margin: -0.6rem 0 1.4rem !important;
    font-size: 1.05rem !important;
    font-style: italic;
    color: var(--text-muted) !important;
  }
  .offclock-sub { font-style: italic; opacity: 0.8; margin-top: -0.4rem !important; }
  .offclock-title { font-family: 'Bricolage Grotesque', Inter, system-ui, sans-serif; font-optical-sizing: auto; }
  .offclock-title .chapter-num { margin-right: 0.7rem; }

  .manual-intro { max-width: 44rem; color: var(--text-secondary); margin: 0 0 1.75rem; }

  /* ============ Departures board ===================================== */
  /* Dark in both themes, like the real thing. The near-black is the site's
     --color-on-green token, so it is an existing value, only pinned. */
  .board {
    background: #0e0c19;
    color: #f0f0f0;
    border-radius: 18px;
    padding: 0.5rem 1.4rem 0.6rem;
    perspective: 900px;
    box-shadow: var(--shadow-lift);
  }

  .board-head,
  .board-row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 1.1fr);
    gap: 1.5rem;
    align-items: center;
  }

  .board-head {
    padding: 0.9rem 0 0.7rem;
    font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(240, 240, 240, 0.5);
    border-bottom: 1px solid rgba(240, 240, 240, 0.12);
  }
  .board-head span:last-child { text-align: right; }

  .board-row {
    padding: 1.35rem 0;
    border-bottom: 1px solid rgba(240, 240, 240, 0.08);
    transform-origin: top;
    /* Flapped in by the script once the board is on screen; without JS the
       rows are simply there. */
  }
  .board-row:last-child { border-bottom: 0; }

  .board.is-armed .board-row { opacity: 0; transform: rotateX(-65deg); }
  .board.is-live .board-row {
    animation: flap-in 0.55s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 80ms);
  }
  @keyframes flap-in { from { opacity: 0; transform: rotateX(-65deg); } to { opacity: 1; transform: none; } }

  .board-lead { display: flex; align-items: center; gap: 0.9rem; min-width: 0; }

  .board-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgba(240, 240, 240, 0.18);
    color: #6dc402;
  }

  .board-need {
    margin: 0;
    font-size: 1.22rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: #ffffff;
  }

  .board-gate {
    margin: 0;
    font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6dc402;
  }
  /* Only the linked channels are actions; the arrow says so, since the
     unlinked ones wear the same green. */
  .board-gate a { color: #6dc402; text-decoration: none; border-bottom: 1px solid rgba(109, 196, 2, 0.5); }
  .board-gate a::after { content: ' \2197'; font-size: 0.85em; }
  .board-gate a:hover { color: #8fd640; border-bottom-color: #8fd640; }

  .board-note {
    display: block;
    margin-top: 0.25rem;
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0;
    text-transform: none;
    color: rgba(240, 240, 240, 0.55);
  }

  .board-time {
    margin: 0;
    text-align: right;
    font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.92rem;
    line-height: 1.4;
    color: #f0f0f0;
  }

  /* Read out with its column name; the visual header is aria-hidden. Clipped
     rather than display:none so it stays in the accessibility tree. */
  .board-time-label {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  /* ============ Body: the documentation grid ========================== */
  /* Chapters 03–06 are a rail and a body. The rail holds what identifies the
     chapter (numeral, heading, deck, provenance) and stays put while the body
     scrolls; the body is a reading column, so prose sits at about 70
     characters a line instead of the 125 a full container gives, and the
     objects (chart, bars, rings) fill that column edge to edge. */
  .manual-grid { padding-top: 1rem; }
  .manual-prose { max-width: none; margin: 0; }
  .manual-block { padding: 3.25rem 0 0; }
  .manual-block + .manual-block { margin-top: 3.25rem; border-top: 1px solid var(--border-color); }
  .manual-block p { font-size: var(--fs-body); line-height: var(--lh-body); color: var(--text-secondary); margin: 0 0 1rem; }
  .manual-block .section-heading, .manual-section { scroll-margin-top: 4rem; }
  .chapter-body > :last-child { margin-bottom: 0 !important; }
  .chapter-body { max-width: 44rem; container-type: inline-size; }

  /* Text and objects alike run the full width of the body column: Warren's
     call, 5 September, over a capped reading measure. */
  .chapter-head .source-note { margin: -0.6rem 0 1.4rem !important; }

  @media (min-width: 1024px) {
    .manual-layout {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }
    .contents { position: sticky; top: 2.5rem; }
    .chapter-body { max-width: none; }
  }

  /* ============ Chapter list (jump bar + rail) ========================= */
  .jump-link { display: inline-flex; align-items: baseline; gap: 0.5rem; color: var(--text-muted); text-decoration: none; }
  .jump-num {
    font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-green-text);
  }
  .jump-label { font-size: 0.9rem; font-weight: 600; }
  .jump-link.is-current { color: var(--text-primary); }
  .jump-link:hover { color: var(--text-primary); }

  /* Rail: the six chapters as a list, current one marked. */
  .contents { display: none; padding-top: 3.25rem; }
  .contents .jump-link { display: flex; padding: 0.55rem 0; border-bottom: 1px solid var(--border-color); }
  .contents .jump-link:first-child { border-top: 1px solid var(--border-color); }
  .contents .jump-link.is-current { box-shadow: inset 3px 0 0 var(--color-green); padding-left: 0.75rem; }
  .contents .jump-link { transition: padding-left 0.2s ease; }
  @media (min-width: 1024px) { .contents { display: block; } .jump { display: none; } }

  /* Menu: sticks to the top on phones and tablets. A native details element,
     so it is a button and a list to the accessibility tree without any
     script; the summary names the section and the chapter in view, the list
     names all six. Nothing scrolls itself. */
  .jump {
    position: sticky;
    top: 0;
    z-index: 5;
    background: rgba(244, 244, 242, 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
  }
  .jump-summary { list-style: none; cursor: pointer; }
  .jump-summary::-webkit-details-marker { display: none; }
  .jump-summary-inner { display: flex; align-items: center; gap: 0.7rem; min-height: 48px; }
  .jump-title {
    flex-shrink: 0;
    color: var(--text-muted);
    font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .jump-current { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.92rem; font-weight: 600; color: var(--text-primary); }
  .jump-current { display: inline-flex; align-items: baseline; gap: 0.5rem; }
  .jump-current.is-empty::before { content: '\2014'; color: var(--text-muted); }
  .jump-caret { flex-shrink: 0; width: 9px; height: 9px; border-right: 2px solid var(--text-primary); border-bottom: 2px solid var(--text-primary); transform: rotate(45deg) translateY(-2px); transition: transform 0.2s ease; }
  .jump[open] .jump-caret { transform: rotate(225deg) translateY(-1px); }
  .jump-list { position: absolute; left: 0; right: 0; top: 100%; background: var(--bg-primary); border-bottom: 1px solid var(--border-color); box-shadow: 0 18px 40px rgba(14, 12, 25, 0.14); }
  .jump-list .jump-link { display: flex; padding: 0.75rem 0; border-top: 1px solid var(--border-color); }
  .jump-list .jump-link.is-current { color: var(--text-primary); box-shadow: inset 3px 0 0 var(--color-green); padding-left: 0.75rem; }
  .jump-list .jump-label { white-space: normal; }

  /* ============ Figures ============================================== */
  /* Manual furniture: every object on the page is a numbered figure, which is
     what ties a departures board, a bar chart and four rings into one book. */
  .fig { display: flex; gap: 0.7rem; align-items: baseline; margin: 0.8rem 0 1.5rem !important; font-size: 0.82rem !important; color: var(--text-muted) !important; }
  .fig-label { flex-shrink: 0; color: var(--text-primary); }

  /* One label voice for every piece of metadata on the page: the spec plate,
     the board header, the chart, the trait names, the evidence sources, the
     figure numbers, the colophon. Colours stay with their owners. */
  .spec-title, .board-head, .avail-label, .trait-dim, .agree-src, .colophon-label, .fig-label, .offclock-asks, .avail-key, .cover-tagline {
    font-family: 'SF Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* A sub-heading step between the chapter heading and body copy. At body
     size and bold, an h3 read as an emphatic paragraph; at this size in the
     display face it reads as what it is. */
  .sub-heading {
    margin: 2.4rem 0 0.35rem;
    font-family: 'Bricolage Grotesque', Inter, system-ui, sans-serif;
    font-optical-sizing: auto;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .manual-list { margin: 0 0 1.25rem; padding-left: 1.1rem; color: var(--text-secondary); }
  .manual-list li { font-size: var(--fs-body); line-height: var(--lh-body); margin-bottom: 0.5rem; }
  .manual-list li::marker { color: var(--color-green); }

  /* ============ Off the clock (green band) ============================ */
  .offclock {
    background: var(--color-green);
    color: var(--color-on-green);
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
  }
  .offclock-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  /* The chip row is nowrap with its own scroll; without this the column
     grows to the row's full width and the band overflows the screen. */
  .offclock-inner > * { min-width: 0; }
  .offclock-title {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-on-green);
  }
  .offclock-title .chapter-num { color: var(--color-on-green); opacity: 0.55; }
  .offclock-text p { font-size: 1.08rem; line-height: 1.55; color: var(--color-on-green); margin: 0 0 1rem; max-width: 34rem; }
  .offclock-text :global(a) { color: var(--color-on-green); font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .offclock-text :global(a:hover) { text-decoration-thickness: 3px; }
  .offclock-asks { font-size: 0.8rem !important; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; margin: 1.5rem 0 0.6rem !important; }
  /* Topics are information, so they are set as text: one line that wraps,
     with a dot between items. Anything shaped like a pill read as a button. */
  .offclock-topics { font-size: 1.02rem !important; line-height: 1.7 !important; font-weight: 600; }
  .offclock-sep { margin: 0 0.15rem 0 0.05rem; opacity: 0.55; }
  .offclock-photo {
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 4px solid rgba(14, 12, 25, 0.25);
    transform: rotate(-2deg);
  }

  /* Helps / doesn't as two typographic lists with big marks, not cards. */
  .hd { display: grid; grid-template-columns: 1fr; gap: 1.75rem 3rem; margin: 0.25rem 0 0; }
  /* Two columns only when the body column itself can give each list a
     readable measure; a viewport breakpoint cannot know that once the rail
     has taken its share. */
  @container (min-width: 42rem) { .hd { grid-template-columns: 1fr 1fr; column-gap: clamp(2.5rem, 6cqw, 4rem); } }
  .hd-head {
    margin: 0 0 0.6rem !important;
    font-family: 'Bricolage Grotesque', Inter, system-ui, sans-serif;
    font-size: 1.15rem !important;
    font-weight: 700;
    color: var(--text-primary) !important;
  }
  .hd-list { list-style: none; margin: 0; padding: 0; }
  .hd-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 0.8rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .hd-list li::before {
    position: absolute;
    left: 0;
    top: -0.1rem;
    font-family: 'Bricolage Grotesque', Inter, system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
  }
  .hd-yes li::before { content: '✓'; color: var(--color-green-text); }
  .hd-no li::before { content: '✗'; color: var(--text-muted); }

  .caution {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 0.9rem 1.1rem;
    margin: 0 0 0.75rem !important;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--color-green);
    border-radius: 10px;
  }
  .caution-label {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-green-text); white-space: nowrap; padding-top: 0.15rem;
  }
  .caution-text { font-size: 0.95rem; line-height: 1.5; color: var(--text-secondary); }

  /* Availability: the working day to scale on the 08:00–18:00 track the
