    };
    const update = () => {
      const line = window.innerHeight * 0.4;
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let id = '';
      if (atEnd) id = chapters[chapters.length - 1].id;
      else for (const c of chapters) { if (c.getBoundingClientRect().top <= line) id = c.id; }
      setCurrent(id);
    };
    let ticking = false;
    const onScroll = () => { if (ticking) return; ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
    // Choosing a chapter closes the menu; the browser does the jump.
    links.forEach((a) => a.addEventListener('click', () => { if (menu) menu.open = false; }));
  }

  // Working hours, made local. Three things share one decision about where
  // the reader is: the hours line drops "UK time" for a reader on UK time,
  // the live clock says "in the UK" only to readers elsewhere, and readers
  // elsewhere get the hours in their own zone. A browser that hides its zone
  // (UTC, GMT, Etc/…) or has none gets the safe wording and nothing more.
  //
  // Conversion is from real instants, never a fixed offset: each London
  // wall-clock time on the next working day is turned into an instant by
  // reading London's offset at that instant (re-checked once across a DST
  // change), then formatted in the reader's zone. The bar never moves: a
  // zone shift changes labels, not geometry.
  const hoursOut = document.querySelector<HTMLElement>('[data-avail-hours]');
  const nowOut = document.querySelector<HTMLElement>('[data-avail-now]');
  const localOut = document.querySelector<HTMLElement>('[data-avail-local]');
