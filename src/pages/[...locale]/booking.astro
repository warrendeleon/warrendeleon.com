---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, getLocalePath, localeStaticPaths, type Locale } from '../../i18n/index';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const i18n = t(locale);
const intl = { en: 'en-GB', es: 'es-ES', ca: 'ca-ES', tl: 'tl-PH' }[locale];
---

<BaseLayout
  title={i18n.seo.bookACallTitle}
  description={i18n.seo.bookACallDescription}
  locale={locale}
  currentPath={getLocalePath(locale, '/booking/')}
>
  <section class="section bk-page">
    <div class="container">
      <h1 class="section-title">{i18n.bookACall.title}</h1>
      <p class="bk-subtitle text-muted">{i18n.bookACall.description}</p>
      <p class="bk-intro">{i18n.bookACall.intro}</p>

      <h2 class="bk-expect-title">{i18n.bookACall.expectTitle}</h2>
      <ul class="bk-expect dot-list">
        {i18n.bookACall.expect.map((item: string) => <li>{item}</li>)}
      </ul>

      <div
        class="bk"
        data-locale={locale}
        data-intl={intl}
        data-strings={JSON.stringify(i18n.booking)}
      >
        <!-- The stub. One object that fills in as choices are made and, at the
             end, is the confirmation. Sticky at the top on a phone, because the
             dock owns the bottom; a column on a wide screen. Each filled line is
             a button back to that step, so it doubles as navigation. -->
        <aside class="bk-stub" aria-label={i18n.booking.steps.details}>
          <ol class="bk-stub-lines">
            <li class="bk-stub-line" data-line="type" hidden><button type="button" data-goto="type"></button></li>
            <li class="bk-stub-line" data-line="date" hidden><button type="button" data-goto="date"></button></li>
            <li class="bk-stub-line" data-line="time" hidden><button type="button" data-goto="time"></button></li>
          </ol>
          <p class="bk-stub-hint" aria-live="polite"></p>
        </aside>

        <div class="bk-stage">
          <p class="bk-status" role="status" aria-live="polite"></p>

          <section class="bk-panel" data-step="type">
            <div class="bk-types" role="list"></div>
          </section>

          <section class="bk-panel" data-step="date" hidden>
            <div class="bk-cal-head">
              <button type="button" class="bk-nav" data-month="-1" aria-label={i18n.booking.calendar.previous}>
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <h2 class="bk-month"></h2>
              <button type="button" class="bk-nav" data-month="1" aria-label={i18n.booking.calendar.next}>
                <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>

            <!-- Two renderings of the same month. On a phone every day is a
                 full-width row with a large numeral and a bar whose length is
                 the free time that day: the bar is information, not
                 decoration. On a wide screen the familiar grid returns. -->
            <div class="bk-datebook" role="list"></div>
            <div class="bk-weekdays" aria-hidden="true"></div>
            <div class="bk-grid" role="grid"></div>
            <p class="bk-empty" hidden></p>
          </section>

          <section class="bk-panel" data-step="time" hidden>
            <h2 class="bk-day"></h2>
            <div class="bk-slots" role="group"></div>
            <p class="bk-zone">
              <span class="bk-zone-label"></span>
              <button type="button" class="bk-zone-change" aria-expanded="false"></button>
            </p>
            <p class="bk-zone-picker" hidden>
              <label class="bk-zone-pick-label" for="bk-tz"></label>
              <select id="bk-tz" class="bk-select"></select>
            </p>
          </section>

          <form class="bk-panel bk-form" data-step="details" novalidate hidden>
            <h2 class="bk-form-title"></h2>

            <fieldset class="bk-group">
              <legend class="bk-group-title" data-copy="aboutYou"></legend>
              <div class="bk-row">
                <p class="bk-field">
                  <label for="bk-first"></label>
                  <input id="bk-first" name="firstName" type="text" autocomplete="given-name" required />
                  <span class="bk-error" data-for="firstName" role="alert"></span>
                </p>
                <p class="bk-field">
                  <label for="bk-last"></label>
                  <input id="bk-last" name="lastName" type="text" autocomplete="family-name" required />
                  <span class="bk-error" data-for="lastName" role="alert"></span>
                </p>
              </div>
              <p class="bk-field">
                <label for="bk-email"></label>
                <input id="bk-email" name="email" type="email" autocomplete="email" inputmode="email" required />
                <span class="bk-error" data-for="email" role="alert"></span>
              </p>
              <div class="bk-guests">
                <div class="bk-guest-list"></div>
                <button type="button" class="bk-add-guest">
                  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                  <span></span>
                </button>
                <span class="bk-error" data-for="guests" role="alert"></span>
              </div>
            </fieldset>

            <fieldset class="bk-group bk-locations">
              <legend class="bk-group-title"></legend>
              <!-- Two tiles, each a real radio. The icon says what the medium is,
                   the second line says what will happen, and the chosen one
                   carries the brand green. -->
              <div class="bk-tiles"></div>
              <span class="bk-error" data-for="location" role="alert"></span>
              <p class="bk-field bk-phone" hidden>
                <label for="bk-phone"></label>
                <input id="bk-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
                <span class="bk-hint"></span>
                <span class="bk-error" data-for="phone" role="alert"></span>
              </p>
            </fieldset>

            <fieldset class="bk-group">
              <legend class="bk-group-title" data-copy="prepare"></legend>
              <p class="bk-field">
                <label for="bk-notes"></label>
                <textarea id="bk-notes" name="notes" rows="4" maxlength="2000"></textarea>
                <span class="bk-error" data-for="notes" role="alert"></span>
              </p>
            </fieldset>

            <!-- Never filled by a person. A bot that fills it gets a cheerful
                 nothing rather than an error telling it what went wrong. -->
            <p class="bk-hp" aria-hidden="true">
              <label for="bk-nickname">Nickname</label>
              <input id="bk-nickname" name="nickname" type="text" tabindex="-1" autocomplete="off" />
            </p>

            <div class="bk-turnstile"></div>
            <p class="bk-error bk-form-error" role="alert" hidden></p>
            <button type="submit" class="bk-submit"></button>
          </form>

          <section class="bk-panel bk-done" data-step="done" hidden tabindex="-1">
            <h2 class="bk-done-title"></h2>
            <p class="bk-done-body"></p>
            <p class="bk-done-links"></p>
          </section>
        </div>
      </div>

      <p class="bk-privacy text-muted">
        {i18n.bookACall.privacyNote}
        <a href={getLocalePath(locale, '/privacy/')}>{i18n.bookACall.privacyLink}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<!-- Global on purpose. Astro scopes styles to the markup it can see and prunes
     rules whose selectors never appear in the template, and every element in
     this flow is created at runtime. Every selector is prefixed .bk- so nothing
     leaks past this page. Colours are the site's tokens only. -->
<style is:global>
  .bk-subtitle { margin-bottom: 1.5rem; }
  .bk-intro { max-width: 46rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2rem; }
  .bk-expect-title { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .bk-expect { margin-bottom: 3rem; }
  .bk-privacy { margin-top: 3rem; font-size: 0.9rem; }

  .bk { --bk-hair: 1px solid var(--border-color); }

  /* ---- the stub -------------------------------------------------------- */
  .bk-stub {
    position: sticky; top: 64px; z-index: 5;
    margin: 0 calc(-1 * var(--bk-bleed, 16px)); padding: 0.85rem var(--bk-bleed, 16px) 0.9rem;
    background: var(--bg-primary); border-bottom: var(--bk-hair);
  }
  .bk-stub-lines { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 1rem; }
  .bk-stub-line button {
    background: none; border: 0; padding: 0; margin: 0; cursor: pointer;
    font: inherit; color: var(--text-primary); text-align: left; line-height: 1.4;
  }
  .bk-stub-line[data-line='type'] button { font-weight: 700; }
  .bk-stub-line[data-line='time'] button { font-variant-numeric: tabular-nums; }
  .bk-stub-line button:hover { color: var(--color-green-text); }
  .bk-stub-hint { margin: 0.15rem 0 0; color: var(--text-muted); font-size: 0.9rem; }
  .bk-stub-hint:empty { display: none; }
  .bk-stub.is-done { border-bottom-color: var(--color-green); }

  /* ---- shared step chrome --------------------------------------------- */
  .bk-status { color: var(--text-muted); margin: 1rem 0 0; min-height: 1.2em; }
  .bk-status:empty { display: none; }

  .bk-panel { padding-top: 1.25rem; }
  .bk-panel.is-entering { animation: bk-enter 220ms cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  @keyframes bk-enter { from { opacity: 0; transform: translateX(18px); } to { opacity: 1; transform: none; } }

  /* ---- step one: rows, not cards ------------------------------------- */
  .bk-type {
    display: grid; grid-template-columns: 1fr auto; column-gap: 1rem; align-items: start;
    width: 100%; text-align: left; cursor: pointer;
    background: none; border: 0; border-top: var(--bk-hair); padding: 1.25rem 0; color: inherit; font: inherit;
  }
  .bk-type:last-child { border-bottom: var(--bk-hair); }
  .bk-type-name { grid-column: 1; font-weight: 600; font-size: 1.15rem; line-height: 1.3; }
  .bk-type-duration {
    grid-column: 2; grid-row: 1 / span 3; align-self: start;
    font-weight: 800; font-size: 1.6rem; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums;
    color: var(--text-primary); white-space: nowrap;
  }
  .bk-type-duration small { display: block; font-weight: 500; font-size: 0.8rem; letter-spacing: 0; color: var(--text-muted); margin-top: 0.2rem; text-align: right; }
  .bk-type-meta { grid-column: 1; color: var(--text-muted); font-size: 0.9rem; margin-top: 0.3rem; }
  .bk-type-desc { grid-column: 1; color: var(--text-secondary); line-height: 1.6; margin: 0.5rem 0 0; max-width: 40rem; }
  .bk-type:hover .bk-type-name, .bk-type:focus-visible .bk-type-name { color: var(--color-green-text); }

  /* ---- step two: the month ------------------------------------------- */
  .bk-cal-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; }
  .bk-month { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.01em; margin: 0; }
  .bk-nav {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.75rem; height: 2.75rem; border-radius: 999px; border: var(--bk-hair);
    background: none; color: inherit; cursor: pointer;
  }
  .bk-nav:hover:not(:disabled) { border-color: var(--color-green); color: var(--color-green-text); }
  .bk-nav:disabled { opacity: 0.3; cursor: default; }

  /* the datebook (phones) */
  .bk-dbrow {
    display: grid; grid-template-columns: 3.25rem 3.5rem 1fr; align-items: center; column-gap: 0.75rem;
    width: 100%; text-align: left; background: none; border: 0; border-top: var(--bk-hair);
    padding: 0.7rem 0; color: inherit; font: inherit; cursor: pointer;
  }
  .bk-datebook .bk-dbrow:last-child { border-bottom: var(--bk-hair); }
  .bk-dbrow[disabled] { cursor: default; }
  .bk-db-wd { color: var(--text-muted); font-size: 0.85rem; font-weight: 500; }
  .bk-db-num { font-weight: 800; font-size: 2rem; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .bk-dbrow[disabled] .bk-db-num, .bk-dbrow[disabled] .bk-db-wd { color: var(--text-muted); opacity: 0.45; }
  .bk-db-bar { height: 6px; border-radius: 3px; background: var(--bg-secondary); overflow: hidden; }
  .bk-db-bar > span { display: block; height: 100%; width: 0; border-radius: 3px; background: var(--color-green); transition: width 320ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .bk-dbrow[disabled] .bk-db-bar { visibility: hidden; }
  .bk-dbrow[aria-pressed='true'] .bk-db-num { color: var(--color-green-text); }
  .bk-dbrow[aria-pressed='true'] .bk-db-bar > span { width: 100% !important; }
  .bk-dbrow:hover:not([disabled]) .bk-db-num { color: var(--color-green-text); }

  /* the grid (wide screens) */
  .bk-weekdays, .bk-grid { display: none; grid-template-columns: repeat(7, 1fr); gap: 0.4rem; }
  .bk-weekday { text-align: center; font-size: 0.85rem; color: var(--text-muted); padding-bottom: 0.25rem; }
  .bk-day-cell { aspect-ratio: 1; }
  .bk-day-cell.is-blank { visibility: hidden; }
  .bk-day-btn {
    width: 100%; height: 100%; border-radius: 999px; border: 1px solid transparent;
    background: none; color: var(--text-primary); font: inherit; font-weight: 600; font-size: 1.05rem;
    font-variant-numeric: tabular-nums; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem;
  }
  .bk-day-btn > i { display: block; width: 1rem; height: 3px; border-radius: 2px; background: var(--color-green); opacity: 0.85; }
  .bk-day-btn[disabled] { color: var(--text-muted); opacity: 0.4; cursor: default; }
  .bk-day-btn[disabled] > i { visibility: hidden; }
  .bk-day-btn:hover:not([disabled]) { border-color: var(--color-green); }
  .bk-day-btn[aria-pressed='true'] { background: var(--color-green); color: var(--color-on-green); }
  .bk-day-btn[aria-pressed='true'] > i { background: var(--color-on-green); }

  .bk-empty { margin: 1.25rem 0 0; color: var(--text-muted); }

  /* ---- step three: times, two to a row on a phone ---------------------- */
  .bk-day { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 0.75rem; }
  .bk-slots { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .bk-slot {
    display: flex; align-items: center; justify-content: center; min-height: 3rem;
    background: none; border: var(--bk-hair); border-radius: 10px; padding: 0.6rem 0.75rem;
    color: var(--text-primary); font: inherit; font-weight: 600; font-size: 1.15rem;
    letter-spacing: -0.02em; font-variant-numeric: tabular-nums; cursor: pointer;
  }
  .bk-slot:hover, .bk-slot:focus-visible { border-color: var(--color-green); color: var(--color-green-text); }
  .bk-zone { margin: 1.25rem 0 0; color: var(--text-muted); font-size: 0.9rem; }
  .bk-zone-change {
    background: none; border: 0; padding: 0; margin-left: 0.5rem; cursor: pointer;
    font: inherit; color: var(--color-green-text); text-decoration: underline; text-underline-offset: 3px;
  }
  .bk-zone-picker { margin-top: 0.75rem; max-width: 22rem; }
  .bk-zone-pick-label { display: block; margin-bottom: 0.35rem; font-size: 0.9rem; color: var(--text-muted); }

  /* ---- step four: the form -------------------------------------------- */
  .bk-form-title { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 1.5rem; }
  .bk-group { border: 0; padding: 0; margin: 0 0 2rem; min-width: 0; }
  .bk-group-title { display: block; padding: 0; margin: 0 0 0.9rem; font-weight: 600; font-size: 1.05rem; }
  .bk-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .bk-field { margin: 0 0 1.1rem; }
  .bk-field label { display: block; margin-bottom: 0.4rem; font-weight: 500; font-size: 0.95rem; }
  .bk-field input, .bk-field textarea, .bk-select, .bk-guest input {
    width: 100%; min-height: 3rem; padding: 0.75rem 0.95rem; border: var(--bk-hair); border-radius: 10px;
    background: var(--bg-primary); color: var(--text-primary); font: inherit;
    transition: border-color 140ms ease;
  }
  .bk-field textarea { resize: vertical; min-height: 6rem; }
  .bk-field input::placeholder, .bk-field textarea::placeholder { color: var(--text-muted); }
  .bk-field input:focus-visible, .bk-field textarea:focus-visible, .bk-select:focus-visible, .bk-guest input:focus-visible { border-color: var(--color-green); }
  .bk-hint { display: block; margin-top: 0.4rem; font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; }

  /* the two tiles */
  .bk-tiles { display: grid; gap: 0.75rem; }
  .bk-tile {
    position: relative; display: grid; grid-template-columns: 2.5rem 1fr auto; column-gap: 0.9rem; align-items: center;
    padding: 1rem 1.1rem; border: var(--bk-hair); border-radius: 12px; cursor: pointer;
    transition: border-color 140ms ease;
  }
  .bk-tile input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .bk-tile-icon { display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--bg-secondary); color: var(--text-secondary); }
  .bk-tile-icon svg { width: 22px; height: 22px; }
  .bk-tile-name { display: block; font-weight: 600; line-height: 1.3; }
  .bk-tile-help { display: block; color: var(--text-muted); font-size: 0.875rem; line-height: 1.45; margin-top: 0.15rem; }
  .bk-tile-check { width: 1.35rem; height: 1.35rem; border-radius: 999px; border: var(--bk-hair); display: flex; align-items: center; justify-content: center; color: var(--color-on-green); }
  .bk-tile-check svg { width: 14px; height: 14px; opacity: 0; }
  .bk-tile:hover { border-color: var(--color-green); }
  .bk-tile:has(input:focus-visible) { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }
  .bk-tile:has(input:checked) { border-color: var(--color-green); }
  .bk-tile:has(input:checked) .bk-tile-icon { background: var(--color-green); color: var(--color-on-green); }
  .bk-tile:has(input:checked) .bk-tile-check { background: var(--color-green); border-color: var(--color-green); }
  .bk-tile:has(input:checked) .bk-tile-check svg { opacity: 1; }
  .bk-locations .bk-phone { margin-top: 1rem; }

  /* guests */
  .bk-guests { margin: 0.25rem 0 0; }
  .bk-guest { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
  .bk-guest input { flex: 1; }
  .bk-guest-remove {
    flex: none; width: 3rem; border: var(--bk-hair); border-radius: 10px; background: none; cursor: pointer;
    color: var(--text-secondary); font: inherit; font-size: 1.25rem; line-height: 1;
  }
  .bk-guest-remove:hover { border-color: var(--color-green); color: var(--color-green-text); }
  .bk-add-guest {
    display: inline-flex; align-items: center; gap: 0.45rem; background: none; border: 0; padding: 0.25rem 0;
    cursor: pointer; color: var(--color-green-text); font: inherit; font-weight: 500;
  }
  .bk-add-guest:hover span { text-decoration: underline; text-underline-offset: 3px; }

  .bk-error { display: block; margin-top: 0.4rem; font-size: 0.85rem; color: #d64545; }
  .bk-field input[aria-invalid='true'], .bk-field textarea[aria-invalid='true'] { border-color: #d64545; }
  [data-theme='dark'] .bk-field input[aria-invalid='true'], [data-theme='dark'] .bk-field textarea[aria-invalid='true'] { border-color: #ff8a8a; }
  .bk-error:empty { display: none; }
  .bk-form-error { margin: 0 0 1rem; }
  [data-theme='dark'] .bk-error { color: #ff8a8a; }

  .bk-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .bk-turnstile { margin-bottom: 1.25rem; }
  .bk-turnstile:empty { display: none; }

  .bk-submit {
    display: block; width: 100%; min-height: 3.25rem; padding: 0.9rem 1.25rem; border-radius: 12px; border: 0; cursor: pointer;
    background: var(--color-green); color: var(--color-on-green); font: inherit; font-weight: 700; font-size: 1.05rem;
    transition: background 140ms ease;
  }
  .bk-submit:hover:not([disabled]) { background: var(--color-green-dark); }
  .bk-submit[disabled] { opacity: 0.45; cursor: not-allowed; }

  /* ---- done ------------------------------------------------------------ */
  .bk-done-title { font-size: var(--fs-h2); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 0.75rem; }
  .bk-done-body { color: var(--text-secondary); line-height: 1.7; margin-bottom: 1.25rem; max-width: 40rem; }
  .bk-done-links a { display: inline-block; margin: 0 1.25rem 0.5rem 0; }

  /* ---- layout by device ----------------------------------------------- */
  @media (max-width: 899px) {
    .bk { --bk-bleed: 16px; }
    .bk-page .container { --bk-bleed: 16px; }
  }
  @media (min-width: 560px) {
    .bk-tiles { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 900px) {
    .bk { display: grid; grid-template-columns: 17rem minmax(0, 1fr); column-gap: 3.5rem; align-items: start; }
    .bk-stub {
      position: sticky; top: 88px; margin: 0; padding: 1rem 0 0;
      background: none; border-bottom: 0; border-top: 3px solid var(--color-green);
    }
    .bk-stub-lines { flex-direction: column; gap: 0.35rem; }
    .bk-stub-line[data-line='type'] button { font-size: 1.15rem; }
    .bk-stub-hint { margin-top: 0.75rem; }
    .bk-panel { padding-top: 0; }
    .bk-datebook { display: none; }
    .bk-weekdays, .bk-grid { display: grid; }
    .bk-slots { grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: 0.6rem; }
    .bk-submit { width: auto; min-width: 14rem; }
  }
  @media (max-width: 560px) {
    .bk-row { grid-template-columns: 1fr; gap: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bk-panel.is-entering { animation: none; }
    .bk-db-bar > span, .bk-slot::after { transition: none; }
  }
</style>

<script>
  // The booking flow. Four steps on one page, with the state in the URL hash so
  // Back walks the steps and a refresh or a shared link lands where it points.

  declare function t(event: string, data?: Record<string, unknown>): void;

  interface EventType {
    slug: string; name: string; description: string; durationMinutes: number; locations: string[];
    question?: string | null; questionRequired?: boolean;
  }
  interface Slot { startUTC: string; endUTC: string }
  type Days = Record<string, Slot[]>;
  type Step = 'type' | 'date' | 'time' | 'details' | 'done';

  const mounted = document.querySelector<HTMLElement>('.bk');
  if (mounted) {
    const root: HTMLElement = mounted;
    const S = JSON.parse(root.dataset.strings || '{}');
    const INTL = root.dataset.intl || 'en-GB';
    const LOCALE = root.dataset.locale || 'en';
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const panels = new Map<Step, HTMLElement>();
    root.querySelectorAll<HTMLElement>('.bk-panel').forEach((p) => panels.set(p.dataset.step as Step, p));
    const status = root.querySelector<HTMLElement>('.bk-status')!;
    const stub = root.querySelector<HTMLElement>('.bk-stub')!;
    const form = root.querySelector<HTMLFormElement>('.bk-form')!;

    let types: EventType[] = [];
    let chosen: EventType | null = null;
    let month = '';
    let days: Days = {};
    let date = '';
    let slot: Slot | null = null;
    let current: Step = 'type';
    let zone = 'UTC';
    try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'; } catch { /* keep UTC */ }

    const say = (message: string) => { status.textContent = message; };
    const todayKey = () => new Date().toISOString().slice(0, 10);
    const fmtDay = (iso: string) =>
      new Date(`${iso}T12:00:00Z`).toLocaleDateString(INTL, { weekday: 'long', day: 'numeric', month: 'long' });
    const fmtShortDay = (iso: string) =>
      new Date(`${iso}T12:00:00Z`).toLocaleDateString(INTL, { weekday: 'short', day: 'numeric', month: 'short' });
    const fmtTime = (iso: string) =>
      new Date(iso).toLocaleTimeString(INTL, { hour: '2-digit', minute: '2-digit', timeZone: zone });
    const fmtDuration = (minutes: number) => {
      if (minutes < 60) return S.duration.minutes.replace('{n}', String(minutes));
      const hours = minutes / 60;
      return hours === 1 ? S.duration.hour : S.duration.hours.replace('{n}', String(hours));
    };

    /** What earned this booking, captured on the visitor's first page. */
    function attribution(): Record<string, string> {
      let first: Record<string, string> = {};
      try { first = JSON.parse(sessionStorage.getItem('utm.first') || '{}'); } catch { /* private mode */ }
      const utm: Record<string, string> = { source: first.utm_source || 'website', medium: first.utm_medium || 'internal' };
      if (first.utm_campaign) utm.campaign = first.utm_campaign;
      try {
        const ref = document.referrer ? new URL(document.referrer) : null;
        if (ref && ref.origin === location.origin && ref.pathname !== location.pathname) {
          utm.content = ref.pathname.replace(/^\/|\/$/g, '').slice(0, 100) || 'home';
        } else if (first.utm_content) utm.content = first.utm_content;
      } catch { /* ignore */ }
      return utm;
    }
    const track = (event: string, extra: Record<string, unknown> = {}) => {
      if (typeof t !== 'function') return;
      const a = attribution();
      t(event, { locale: LOCALE, source: a.source, medium: a.medium, from: a.content || '', ...extra });
    };

    // ---- the stub and the steps ------------------------------------------

    function renderStub() {
      const line = (name: string, text: string, visible: boolean) => {
        const li = stub.querySelector<HTMLElement>(`.bk-stub-line[data-line="${name}"]`)!;
        li.hidden = !visible;
        li.querySelector('button')!.textContent = text;
      };
      line('type', chosen ? `${chosen.name}, ${fmtDuration(chosen.durationMinutes)}` : '', !!chosen);
      line('date', date ? fmtShortDay(date) : '', !!date);
      line('time', slot ? fmtTime(slot.startUTC) : '', !!slot);

      const hint: Record<Step, string> = {
        type: S.hints.type, date: S.hints.date, time: S.hints.time, details: S.hints.details, done: '',
      };
      stub.querySelector<HTMLElement>('.bk-stub-hint')!.textContent = hint[current];
      stub.classList.toggle('is-done', current === 'done');
    }

    function show(step: Step) {
      current = step;
      panels.forEach((panel, name) => {
        const entering = name === step && panel.hidden;
        panel.hidden = name !== step;
        if (entering && !reducedMotion) {
          panel.classList.remove('is-entering');
          void panel.offsetWidth; // restart the animation even if the class was still present
          panel.classList.add('is-entering');
        }
      });
      renderStub();
      if (step === 'done') panels.get('done')!.focus();
    }

    function writeHash() {
      const parts: string[] = [];
      if (chosen) parts.push(`type=${chosen.slug}`);
      if (date) parts.push(`date=${date}`);
      if (slot) parts.push(`slot=${encodeURIComponent(slot.startUTC)}`);
      const next = parts.length ? `#${parts.join('&')}` : ' ';
      if (location.hash !== next) history.pushState(null, '', next);
    }
    function readHash(): Record<string, string> {
      const out: Record<string, string> = {};
      for (const pair of location.hash.replace(/^#/, '').split('&')) {
        const [k, v] = pair.split('=');
        if (k && v) out[k] = decodeURIComponent(v);
      }
      return out;
    }

    // ---- step one -----------------------------------------------------------

    async function loadTypes() {
      say(S.calendar.loading);
      try {
        const response = await fetch(`/api/booking/types?locale=${LOCALE}`);
        if (!response.ok) throw new Error(String(response.status));
        types = (await response.json()).types as EventType[];
      } catch { say(S.errors.generic); return; }
      say('');
      const list = root.querySelector<HTMLElement>('.bk-types')!;
      if (types.length === 0) { list.textContent = S.empty; return; }
      list.replaceChildren(...types.map((type) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'bk-type';
        button.setAttribute('role', 'listitem');
        const name = document.createElement('span'); name.className = 'bk-type-name'; name.textContent = type.name;
        const duration = document.createElement('span'); duration.className = 'bk-type-duration';
        const [big, small] = fmtDuration(type.durationMinutes).split(' ');
        duration.textContent = big ?? '';
        const unit = document.createElement('small'); unit.textContent = small ?? '';
        duration.appendChild(unit);
        const meta = document.createElement('span'); meta.className = 'bk-type-meta';
        meta.textContent = type.locations.map((l) => S.locations[l] ?? l).join(', ');
        const desc = document.createElement('p'); desc.className = 'bk-type-desc'; desc.textContent = type.description;
        button.append(name, duration, meta, desc);
        button.addEventListener('click', () => pickType(type));
        return button;
      }));
      renderStub();
    }

    async function pickType(type: EventType) {
      chosen = type; date = ''; slot = null; days = {};
      month = todayKey().slice(0, 7);
      writeHash();
      track('booking_type_picked', { type: type.slug, minutes: type.durationMinutes });
      show('date');
      await loadMonth();
    }

    // ---- step two -----------------------------------------------------------

    function shiftMonth(by: number): string {
      const [y, m] = month.split('-').map(Number);
      const d = new Date(Date.UTC(y!, m! - 1 + by, 1));
      return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
    }

    async function loadMonth() {
      const label = root.querySelector<HTMLElement>('.bk-month')!;
      label.textContent = new Date(`${month}-01T12:00:00Z`).toLocaleDateString(INTL, { month: 'long', year: 'numeric' });
      root.querySelector<HTMLElement>('.bk-grid')!.replaceChildren();
      root.querySelector<HTMLElement>('.bk-datebook')!.replaceChildren();
      root.querySelector<HTMLElement>('.bk-empty')!.hidden = true;
      say(S.calendar.loading);
      try {
        const response = await fetch(`/api/booking/availability?type=${chosen!.slug}&month=${month}`);
        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          say(body.error === 'calendar_unavailable' ? S.errors.calendarUnavailable : S.errors.generic);
          return;
        }
        days = (await response.json()).days as Days;
      } catch { say(S.errors.calendarUnavailable); return; }
      say('');
      renderWeekdays();
      renderGrid();
      renderDatebook();
      root.querySelector<HTMLButtonElement>('.bk-nav[data-month="-1"]')!.disabled = month <= todayKey().slice(0, 7);
      const empty = root.querySelector<HTMLElement>('.bk-empty')!;
      empty.textContent = S.calendar.noDays;
      empty.hidden = Object.keys(days).length > 0;
    }

    function monthDates(): string[] {
      const [y, m] = month.split('-').map(Number);
      const length = new Date(Date.UTC(y!, m!, 0)).getUTCDate();
      return Array.from({ length }, (_, i) => `${month}-${String(i + 1).padStart(2, '0')}`);
    }

    function renderWeekdays() {
      const head = root.querySelector<HTMLElement>('.bk-weekdays')!;
      if (head.childElementCount > 0) return;
      // 5 January 2026 was a Monday: this walks Monday to Sunday in the locale's own words.
      head.replaceChildren(...Array.from({ length: 7 }, (_, i) => {
        const cell = document.createElement('span');
        cell.className = 'bk-weekday';
        cell.textContent = new Date(Date.UTC(2026, 0, 5 + i)).toLocaleDateString(INTL, { weekday: 'short' });
        return cell;
      }));
    }

    /** Wide screens: the familiar grid, with a small mark under every free day. */
    function renderGrid() {
      const grid = root.querySelector<HTMLElement>('.bk-grid')!;
      const dates = monthDates();
      const lead = (new Date(`${dates[0]}T12:00:00Z`).getUTCDay() + 6) % 7;
      const cells: HTMLElement[] = [];
      for (let i = 0; i < lead; i += 1) {
        const blank = document.createElement('div'); blank.className = 'bk-day-cell is-blank'; cells.push(blank);
      }
      for (const iso of dates) {
        const cell = document.createElement('div'); cell.className = 'bk-day-cell';
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'bk-day-btn';
        button.textContent = iso.slice(8).replace(/^0/, '');
        button.appendChild(document.createElement('i'));
        const free = (days[iso] || []).length > 0;
        button.disabled = !free;
        button.setAttribute('aria-pressed', String(iso === date));
        button.setAttribute('aria-label', fmtDay(iso));
        if (free) button.addEventListener('click', () => pickDate(iso));
        cell.appendChild(button); cells.push(cell);
      }
      grid.replaceChildren(...cells);
    }

    /**
     * Phones: the month as a datebook. One row per day from today onwards, a
     * large numeral, and a bar whose length is how much of that day is free.
     * Past days are simply not there; a phone has no room for what cannot be
     * booked.
     */
    function renderDatebook() {
      const book = root.querySelector<HTMLElement>('.bk-datebook')!;
      const today = todayKey();
      const most = Math.max(1, ...Object.values(days).map((list) => list.length));
      const rows: HTMLElement[] = [];
      for (const iso of monthDates()) {
        if (iso < today) continue;
        const count = (days[iso] || []).length;
        const row = document.createElement('button');
        row.type = 'button'; row.className = 'bk-dbrow'; row.setAttribute('role', 'listitem');
        row.disabled = count === 0;
        row.setAttribute('aria-pressed', String(iso === date));
        row.setAttribute('aria-label', fmtDay(iso));
        const wd = document.createElement('span'); wd.className = 'bk-db-wd';
        wd.textContent = new Date(`${iso}T12:00:00Z`).toLocaleDateString(INTL, { weekday: 'short' });
        const num = document.createElement('span'); num.className = 'bk-db-num';
        num.textContent = iso.slice(8).replace(/^0/, '');
        const bar = document.createElement('span'); bar.className = 'bk-db-bar';
        const fill = document.createElement('span');
        bar.appendChild(fill);
        fill.style.width = `${Math.round((count / most) * 100)}%`;
        row.append(wd, num, bar);
        if (count > 0) row.addEventListener('click', () => pickDate(iso));
        rows.push(row);
      }
      book.replaceChildren(...rows);
    }

    function pickDate(iso: string) {
      date = iso; slot = null;
      writeHash();
      show('time');
      renderSlots();
    }

    // ---- step three ---------------------------------------------------------

    function renderSlots() {
      root.querySelector<HTMLElement>('.bk-day')!.textContent = fmtDay(date);
      const holder = root.querySelector<HTMLElement>('.bk-slots')!;
      const list = days[date] || [];
      if (list.length === 0) { holder.textContent = S.times.none; return; }
      holder.replaceChildren(...list.map((candidate) => {
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'bk-slot';
        button.textContent = fmtTime(candidate.startUTC);
        button.addEventListener('click', () => pickSlot(candidate));
        return button;
      }));
      renderZone();
    }

    function renderZone() {
      const label = root.querySelector<HTMLElement>('.bk-zone-label')!;
      const change = root.querySelector<HTMLButtonElement>('.bk-zone-change')!;
      const picker = root.querySelector<HTMLElement>('.bk-zone-picker')!;
      const select = root.querySelector<HTMLSelectElement>('#bk-tz')!;
      // Detected, not asked for: a sentence with the alternatives behind a link.
      label.textContent = S.times.zone.replace('{zone}', zone.replace(/_/g, ' '));
      change.textContent = S.times.changeZone;
      root.querySelector<HTMLElement>('.bk-zone-pick-label')!.textContent = S.times.changeZone;
      if (!change.dataset.wired) {
        change.dataset.wired = 'yes';
        change.addEventListener('click', () => {
          picker.hidden = !picker.hidden;
          change.setAttribute('aria-expanded', String(!picker.hidden));
          if (!picker.hidden) select.focus();
        });
      }
      if (select.options.length === 0) {
        let all: string[] = [zone];
        try { all = (Intl as never as { supportedValuesOf(k: string): string[] }).supportedValuesOf('timeZone'); } catch { /* older browser */ }
        select.replaceChildren(...all.map((name) => {
          const option = document.createElement('option');
          option.value = name; option.textContent = name.replace(/_/g, ' '); option.selected = name === zone;
          return option;
        }));
        select.addEventListener('change', () => { zone = select.value; renderSlots(); renderStub(); });
      }
    }

    function pickSlot(candidate: Slot) {
      slot = candidate;
      writeHash();
      track('booking_slot_picked', { type: chosen!.slug, date });
      show('details');
      renderForm();
    }

    // ---- step four ----------------------------------------------------------

    const ICON: Record<string, string> = {
      video: '<path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>',
      phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
    };
    const svg = (paths: string) =>
      `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

    function renderForm() {
      const set = (selector: string, text: string) => {
        const node = root.querySelector<HTMLElement>(selector);
        if (node) node.textContent = text;
      };
      set('.bk-form-title', S.form.heading);
      set('[data-copy="aboutYou"]', S.form.aboutYou);
      set('[data-copy="prepare"]', S.form.prepare);
      set('label[for="bk-first"]', S.form.firstName);
      set('label[for="bk-last"]', S.form.lastName);
      set('label[for="bk-email"]', S.form.email);
      set('label[for="bk-phone"]', S.form.phone);
      set('.bk-phone .bk-hint', S.form.phoneHelp);
      const ask = chosen!.question || S.form.question;
      set('label[for="bk-notes"]', chosen!.questionRequired ? ask : `${ask} (${S.form.optional})`);
      set('.bk-add-guest span', S.form.addGuests);
      set('.bk-submit', S.form.submit);
      set('.bk-locations .bk-group-title', S.form.location);

      const tiles = root.querySelector<HTMLElement>('.bk-tiles')!;
      tiles.replaceChildren(...chosen!.locations.map((kind, index) => {
        const tile = document.createElement('label');
        tile.className = 'bk-tile';
        tile.innerHTML =
          `<span class="bk-tile-icon">${svg(ICON[kind] ?? ICON.video!)}</span>` +
          `<span><span class="bk-tile-name"></span><span class="bk-tile-help"></span></span>` +
          `<span class="bk-tile-check">${svg('<path d="M20 6 9 17l-5-5"/>')}</span>`;
        tile.querySelector('.bk-tile-name')!.textContent = S.locations[kind] ?? kind;
        tile.querySelector('.bk-tile-help')!.textContent = S.locations[`${kind}Help`] ?? '';
        const input = document.createElement('input');
        input.type = 'radio'; input.name = 'location'; input.value = kind; input.checked = index === 0;
        input.setAttribute('aria-label', S.locations[kind] ?? kind);
        input.addEventListener('change', togglePhone);
        tile.prepend(input);
        return tile;
      }));
      clearErrors();
      form.querySelectorAll<HTMLElement>('[data-checked]').forEach((n) => { delete n.dataset.checked; });
      togglePhone();
    }

    function togglePhone() {
      const picked = form.querySelector<HTMLInputElement>('input[name="location"]:checked');
      const phoneField = root.querySelector<HTMLElement>('.bk-phone')!;
      phoneField.hidden = picked?.value !== 'phone';
      if (phoneField.hidden) setFieldError('phone', '', inputFor('phone'));
      refreshSubmit();
    }

    root.querySelector<HTMLButtonElement>('.bk-add-guest')!.addEventListener('click', () => {
      const list = root.querySelector<HTMLElement>('.bk-guest-list')!;
      if (list.childElementCount >= 5) return;
      const row = document.createElement('div'); row.className = 'bk-guest';
      const input = document.createElement('input');
      input.type = 'email'; input.placeholder = S.form.guestEmail; input.setAttribute('aria-label', S.form.guestEmail);
      const remove = document.createElement('button');
      remove.type = 'button'; remove.className = 'bk-guest-remove'; remove.textContent = '×';
      remove.title = S.form.removeGuest;
      remove.setAttribute('aria-label', S.form.removeGuest);
      remove.addEventListener('click', () => { row.remove(); checkGuests(true); refreshSubmit(); });
      row.append(input, remove); list.appendChild(row); input.focus();
      refreshSubmit();
    });

    function clearErrors() {
      root.querySelectorAll<HTMLElement>('.bk-error').forEach((node) => { node.textContent = ''; });
      root.querySelectorAll<HTMLElement>('[aria-invalid]').forEach((node) => {
        node.removeAttribute('aria-invalid'); node.removeAttribute('aria-describedby');
      });
      root.querySelector<HTMLElement>('.bk-form-error')!.hidden = true;
    }
    function messageFor(name: string, code: string): string {
      if (name === 'guests') return code === 'too_many' ? S.errors.tooManyGuests : S.errors.guests;
      if (code === 'invalid') {
        if (name === 'email') return S.errors.email;
        if (name === 'phone') return S.errors.phone;
        if (name === 'firstName' || name === 'lastName') return S.errors.name;
      }
      return S.errors.required;
    }

    // ---- live validation -----------------------------------------------------
    // The same rules the API applies, run in the browser as the visitor goes.
    // A field checks itself when it is left, then corrects itself on every
    // keystroke once it has shown an error. The button stays disabled until
    // every required field passes. The API remains the authority.

    const HAS_LETTER = /\p{L}/u;
    const LOOKS_LIKE_LINK = /https?:|www\.|@/i;
    const EMAIL_SHAPE = /^[^\s@]+@[^\s@.]+\.[^\s@]+$/;
    const PHONE_SHAPE = /^\+?[0-9][0-9\s().-]{6,}$/;

    const nameCode = (v: string) => (!v ? 'required' : !HAS_LETTER.test(v) || LOOKS_LIKE_LINK.test(v) ? 'invalid' : '');
    const emailCode = (v: string) => (!v ? 'required' : !EMAIL_SHAPE.test(v) ? 'invalid' : '');
    const phoneCode = (v: string) => (!v ? 'required' : !PHONE_SHAPE.test(v) ? 'invalid' : '');

    const phoneChosen = () => form.querySelector<HTMLInputElement>('input[name="location"]:checked')?.value === 'phone';

    const RULES: Record<string, (v: string) => string> = {
      firstName: nameCode,
      lastName: nameCode,
      email: emailCode,
      phone: (v) => (phoneChosen() ? phoneCode(v) : ''),
    };

    const inputFor = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]`);
    const errorFor = (name: string) => root.querySelector<HTMLElement>(`.bk-error[data-for="${name}"]`);

    function setFieldError(name: string, code: string, input: HTMLElement | null) {
      const node = errorFor(name);
      if (!node) return;
      if (code) {
        node.id = node.id || `bk-err-${name}`;
        node.textContent = messageFor(name, code);
        input?.setAttribute('aria-invalid', 'true');
        input?.setAttribute('aria-describedby', node.id);
      } else {
        node.textContent = '';
        input?.removeAttribute('aria-invalid');
        input?.removeAttribute('aria-describedby');
      }
    }

    /** Check one named field and show the result beside it. */
    function checkField(name: string): boolean {
      const rule = RULES[name];
      const input = inputFor(name);
      if (!rule || !input) return true;
      const code = rule(input.value.trim());
      setFieldError(name, code, input);
      input.dataset.checked = 'yes';
      return !code;
    }

    /** Guest rows: an empty row is ignored, a filled one must be an address. */
    function checkGuests(show: boolean): boolean {
      const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('.bk-guest input'));
      let code = '';
      for (const input of inputs) {
        const value = input.value.trim();
        const bad = value !== '' && !EMAIL_SHAPE.test(value);
        if (show) { if (bad) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid'); }
        if (bad) code = 'invalid';
      }
      const filled = inputs.filter((i) => i.value.trim() !== '').length;
      if (!code && filled > 5) code = 'too_many';
      if (show) setFieldError('guests', code, null);
      return !code;
    }

    /** Is everything the API will insist on present and well-formed? */
    function formIsComplete(): boolean {
      const okNames = Object.keys(RULES).every((name) => {
        const input = inputFor(name);
        return !input || !RULES[name]!(input.value.trim());
      });
      return okNames && checkGuests(false);
    }

    function refreshSubmit() {
      const submit = form.querySelector<HTMLButtonElement>('.bk-submit')!;
      if (submit.dataset.busy === 'yes') return;
      submit.disabled = !formIsComplete();
    }

    // Leaving a field checks it. Typing in a field that has already been
    // checked re-checks it, so an error clears the moment it is fixed.
    form.addEventListener('focusout', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name in RULES) checkField(target.name);
      if (target.closest('.bk-guest')) checkGuests(true);
      refreshSubmit();
    });
    form.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name in RULES && target.dataset.checked === 'yes') checkField(target.name);
      if (target.closest('.bk-guest') && errorFor('guests')?.textContent) checkGuests(true);
      refreshSubmit();
    });

    /** Run every rule at once and show the results, for the submit backstop. */
    function checkAll(): boolean {
      const results = Object.keys(RULES).map((name) => checkField(name));
      const guestsOk = checkGuests(true);
      const first = root.querySelector<HTMLElement>('[aria-invalid="true"], .bk-error:not(:empty)');
      if (first) {
        first.scrollIntoView({ block: 'center', behavior: 'smooth' });
        if ('focus' in first) (first as HTMLInputElement).focus({ preventScroll: true });
      }
      return results.every(Boolean) && guestsOk;
    }

    function showFieldErrors(fields: Record<string, string>) {
      for (const [name, code] of Object.entries(fields)) setFieldError(name, code, inputFor(name));
      root.querySelector<HTMLElement>('.bk-error:not(:empty)')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      root.querySelector<HTMLElement>('.bk-form-error')!.hidden = true;
      if (!checkAll()) { refreshSubmit(); return; }
      const submit = form.querySelector<HTMLButtonElement>('.bk-submit')!;
      submit.dataset.busy = 'yes';
      submit.disabled = true; submit.textContent = S.form.submitting;
      const banner = (message: string) => {
        const node = root.querySelector<HTMLElement>('.bk-form-error')!;
        node.textContent = message; node.hidden = !message;
        submit.dataset.busy = '';
        submit.textContent = S.form.submit;
        refreshSubmit();
      };

      const data = new FormData(form);
      const guests = Array.from(root.querySelectorAll<HTMLInputElement>('.bk-guest input')).map((i) => i.value.trim()).filter(Boolean);
      const turnstile = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
      const body = {
        type: chosen!.slug, startUTC: slot!.startUTC,
        location: String(data.get('location') || ''),
        firstName: String(data.get('firstName') || '').trim(), lastName: String(data.get('lastName') || '').trim(),
        email: String(data.get('email') || '').trim(), phone: String(data.get('phone') || '').trim(),
        notes: String(data.get('notes') || ''), nickname: String(data.get('nickname') || ''),
        timezone: zone, locale: LOCALE, guests, turnstileToken: turnstile?.value || '', utm: attribution(),
      };


      let response: Response;
      try {
        response = await fetch('/api/booking/bookings', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      } catch { banner(S.errors.generic); return; }
      const payload = await response.json().catch(() => ({}));

      if (response.ok) {
        track('call_booked', { type: chosen!.slug, minutes: chosen!.durationMinutes, location: body.location });
        renderDone(payload, body.email);
        return;
      }
      // A field the page has nowhere to show, such as the anti-spam token,
      // must still produce a visible message: silence looks like a dead button.
      const fields: Record<string, string> = payload.fields ?? {};
      const placed = Object.keys(fields).filter((name) => errorFor(name));
      if (placed.length > 0) showFieldErrors(fields);
      const unplaced = Object.keys(fields).length > placed.length;
      banner(
        payload.error === 'slot_taken' ? S.errors.slotTaken
        : payload.error === 'rate_limited' ? S.errors.rateLimited
        : payload.error === 'calendar_unavailable' ? S.errors.calendarUnavailable
        : placed.length > 0 && !unplaced ? ''
        : S.errors.generic,
      );
    });

    function renderDone(payload: { booking?: { meetLink?: string | null }; manageUrl?: string }, email: string) {
      root.querySelector<HTMLElement>('.bk-done-title')!.textContent = S.confirmed.heading;
      root.querySelector<HTMLElement>('.bk-done-body')!.textContent = S.confirmed.body.replace('{email}', email);
      const links = root.querySelector<HTMLElement>('.bk-done-links')!;
      links.replaceChildren();
      if (payload.booking?.meetLink) {
        const meet = document.createElement('a'); meet.href = payload.booking.meetLink; meet.textContent = S.confirmed.meet; meet.rel = 'noopener'; links.appendChild(meet);
      }
      if (payload.manageUrl) {
        const manage = document.createElement('a'); manage.href = payload.manageUrl; manage.textContent = S.confirmed.manage; links.appendChild(manage);
      }
      show('done');
    }

    // ---- wiring -------------------------------------------------------------

    root.querySelectorAll<HTMLButtonElement>('.bk-nav').forEach((button) => {
      button.addEventListener('click', () => { month = shiftMonth(Number(button.dataset.month)); loadMonth(); });
    });

    stub.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.dataset.goto as Step;
        if (target === 'type') { chosen = null; date = ''; slot = null; }
        if (target === 'date') { date = ''; slot = null; renderGrid(); renderDatebook(); }
        if (target === 'time') { slot = null; }
        writeHash();
        show(target);
      });
    });

    async function applyState(state: Record<string, string>) {
      if (!state.type) { chosen = null; date = ''; slot = null; show('type'); return; }
      const found = types.find((candidate) => candidate.slug === state.type);
      if (!found) { show('type'); return; }
      const sameMonth = chosen?.slug === found.slug && month === (state.date ? state.date.slice(0, 7) : month);
      chosen = found; slot = null; date = '';
      if (!sameMonth || Object.keys(days).length === 0) {
        month = state.date ? state.date.slice(0, 7) : todayKey().slice(0, 7);
        show('date');
        await loadMonth();
      } else {
        show('date');
      }
      if (!state.date || (days[state.date] || []).length === 0) return;
      date = state.date;
      renderGrid(); renderDatebook();
      show('time'); renderSlots();
      const wanted = (days[date] || []).find((candidate) => candidate.startUTC === state.slot);
      if (!wanted) return;
      slot = wanted;
      show('details'); renderForm();
    }

    window.addEventListener('popstate', () => { applyState(readHash()); });
    loadTypes().then(() => applyState(readHash()));
  }
</script>
