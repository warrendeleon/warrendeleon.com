---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, getLocalePath, localeStaticPaths, type Locale } from '../../i18n/index';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const i18n = t(locale);
const intl = { en: 'en-GB', es: 'es-ES', ca: 'ca-ES', tl: 'tl-PH' }[locale];
---

<BaseLayout
  title={i18n.seo.bookACallTitle}
  description={i18n.seo.bookACallDescription}
  locale={locale}
  currentPath={getLocalePath(locale, '/booking/')}
>
  <section class="section">
    <div class="container">
      <h1 class="section-title">{i18n.bookACall.title}</h1>
      <p class="bk-subtitle text-muted">{i18n.bookACall.description}</p>
      <p class="bk-intro">{i18n.bookACall.intro}</p>

      <h2 class="bk-expect-title">{i18n.bookACall.expectTitle}</h2>
      <ul class="bk-expect dot-list">
        {i18n.bookACall.expect.map((item: string) => <li>{item}</li>)}
      </ul>

      <div
        class="bk"
        data-locale={locale}
        data-intl={intl}
        data-strings={JSON.stringify(i18n.booking)}
      >
        <!-- Where the visitor is, shown as a trail rather than a progress bar:
             steps can be revisited, and a bar implies they cannot. -->
        <nav class="bk-trail" aria-label={i18n.booking.steps.type} hidden>
          <button type="button" class="bk-crumb" data-goto="type"></button>
          <button type="button" class="bk-crumb" data-goto="date" hidden></button>
          <button type="button" class="bk-crumb" data-goto="time" hidden></button>
        </nav>

        <p class="bk-status" role="status" aria-live="polite"></p>

        <section class="bk-panel" data-step="type">
          <div class="bk-types"></div>
        </section>

        <section class="bk-panel" data-step="date" hidden>
          <div class="bk-cal-head">
            <button type="button" class="bk-nav" data-month="-1" aria-label={i18n.booking.calendar.previous}>&lsaquo;</button>
            <h2 class="bk-month" aria-live="polite"></h2>
            <button type="button" class="bk-nav" data-month="1" aria-label={i18n.booking.calendar.next}>&rsaquo;</button>
          </div>
          <!-- A grid of buttons rather than a table: the build gate requires
               every table inside an article to be wrapped for scrolling, and a
               month is not tabular data anyone needs to scroll. -->
          <div class="bk-weekdays" aria-hidden="true"></div>
          <div class="bk-grid" role="grid"></div>
          <p class="bk-empty" hidden></p>
        </section>

        <section class="bk-panel" data-step="time" hidden>
          <h2 class="bk-day"></h2>
          <div class="bk-slots" role="group"></div>
          <p class="bk-zone">
            <label class="bk-zone-label" for="bk-tz"></label>
            <select id="bk-tz" class="bk-select"></select>
          </p>
        </section>

        <form class="bk-panel bk-form" data-step="details" novalidate hidden>
          <h2 class="bk-form-title"></h2>
          <p class="bk-chosen"></p>

          <div class="bk-row">
            <p class="bk-field">
              <label for="bk-first"></label>
              <input id="bk-first" name="firstName" type="text" autocomplete="given-name" required />
              <span class="bk-error" data-for="firstName" role="alert"></span>
            </p>
            <p class="bk-field">
              <label for="bk-last"></label>
              <input id="bk-last" name="lastName" type="text" autocomplete="family-name" required />
              <span class="bk-error" data-for="lastName" role="alert"></span>
            </p>
          </div>

          <p class="bk-field">
            <label for="bk-email"></label>
            <input id="bk-email" name="email" type="email" autocomplete="email" required />
            <span class="bk-error" data-for="email" role="alert"></span>
          </p>

          <div class="bk-guests" hidden>
            <div class="bk-guest-list"></div>
            <button type="button" class="bk-add-guest"></button>
          </div>

          <fieldset class="bk-field bk-locations">
            <legend></legend>
            <span class="bk-error" data-for="location" role="alert"></span>
          </fieldset>

          <p class="bk-field bk-phone" hidden>
            <label for="bk-phone"></label>
            <input id="bk-phone" name="phone" type="tel" autocomplete="tel" />
            <span class="bk-hint"></span>
            <span class="bk-error" data-for="phone" role="alert"></span>
          </p>

          <p class="bk-field">
            <label for="bk-notes"></label>
            <textarea id="bk-notes" name="notes" rows="4" maxlength="2000"></textarea>
            <span class="bk-error" data-for="notes" role="alert"></span>
          </p>

          <!-- Never filled by a person. A bot that fills it gets a cheerful
               nothing rather than an error telling it what went wrong. -->
          <p class="bk-hp" aria-hidden="true">
            <label for="bk-nickname">Nickname</label>
            <input id="bk-nickname" name="nickname" type="text" tabindex="-1" autocomplete="off" />
          </p>

          <div class="bk-turnstile"></div>
          <p class="bk-error bk-form-error" role="alert" hidden></p>
          <button type="submit" class="btn btn-primary bk-submit"></button>
        </form>

        <section class="bk-panel bk-done" data-step="done" hidden tabindex="-1">
          <h2 class="bk-done-title"></h2>
          <p class="bk-done-when"></p>
          <p class="bk-done-body"></p>
          <p class="bk-done-links"></p>
        </section>
      </div>

      <p class="bk-privacy text-muted">
        {i18n.bookACall.privacyNote}
        <a href={getLocalePath(locale, '/privacy/')}>{i18n.bookACall.privacyLink}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<!-- Global rather than scoped on purpose. Astro scopes styles to the markup it
     can see and prunes rules whose selectors never appear, and every element in
     this flow is created by JavaScript at runtime. Scoped rules would be
     dropped from the build and would not match the generated nodes anyway.
     Every selector below is prefixed .bk- so nothing leaks past this page. -->
<style is:global>
  .bk-subtitle { margin-bottom: 1.5rem; }
  .bk-intro { max-width: 46rem; color: var(--text-secondary); line-height: 1.7; margin-bottom: 2rem; }
  .bk-expect-title { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .bk-expect { margin-bottom: 2.5rem; }

  .bk { max-width: 46rem; }

  .bk-trail { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 1.5rem; }
  .bk-crumb {
    background: none; border: 0; padding: 0.25rem 0; cursor: pointer;
    color: var(--color-green-text); font-size: 0.95rem; text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bk-crumb + .bk-crumb::before { content: '/'; color: var(--text-muted); margin-right: 0.5rem; text-decoration: none; }

  .bk-status { color: var(--text-muted); margin-bottom: 1rem; min-height: 1.2em; }
  .bk-status:empty { display: none; }

  /* Event types */
  .bk-types { display: grid; gap: 1rem; }
  .bk-type {
    display: block; width: 100%; text-align: left; cursor: pointer;
    background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px;
    padding: 1.25rem; transition: border-color 0.2s ease, transform 0.2s ease;
    color: inherit; font: inherit;
  }
  .bk-type:hover { border-color: var(--color-green); transform: translateY(-2px); }
  .bk-type-name { display: block; font-weight: 600; font-size: 1.05rem; margin-bottom: 0.35rem; }
  .bk-type-meta { display: block; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem; }
  .bk-type-desc { color: var(--text-secondary); line-height: 1.6; margin: 0; }

  /* Month grid */
  .bk-cal-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .bk-month { font-size: 1.15rem; margin: 0; }
  .bk-nav {
    background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px;
    width: 2.75rem; height: 2.75rem; font-size: 1.4rem; line-height: 1; cursor: pointer; color: inherit;
  }
  .bk-nav:hover:not(:disabled) { border-color: var(--color-green); }
  .bk-nav:disabled { opacity: 0.35; cursor: default; }

  .bk-weekdays, .bk-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.4rem; }
  .bk-weekdays { margin-bottom: 0.4rem; }
  .bk-weekday { text-align: center; font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .bk-day-cell { aspect-ratio: 1; }
  .bk-day-btn {
    width: 100%; height: 100%; border-radius: 999px; border: 1px solid transparent;
    background: var(--bg-secondary); color: var(--text-primary); font: inherit; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .bk-day-btn:hover:not(:disabled) { border-color: var(--color-green); }
  .bk-day-btn[disabled] { background: none; color: var(--text-muted); opacity: 0.45; cursor: default; }
  .bk-day-btn[aria-pressed='true'] { background: var(--color-green); color: var(--color-on-green); font-weight: 600; }
  .bk-day-cell.is-blank { visibility: hidden; }

  /* Slots */
  .bk-day { font-size: 1.15rem; margin: 0 0 1rem; }
  .bk-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 0.6rem; }
  .bk-slot {
    padding: 0.85rem 1rem; border-radius: 10px; border: 1px solid var(--color-green);
    background: var(--bg-primary); color: var(--color-green-text); font: inherit; font-weight: 600; cursor: pointer;
  }
  .bk-slot:hover { background: var(--color-green); color: var(--color-on-green); }
  .bk-zone { margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem; }
  .bk-zone-label { display: block; margin-bottom: 0.35rem; }

  /* Form */
  .bk-form-title { font-size: 1.15rem; margin: 0 0 0.5rem; }
  .bk-chosen { color: var(--text-secondary); margin-bottom: 1.5rem; }
  .bk-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .bk-field { margin: 0 0 1.25rem; }
  .bk-field label, .bk-locations legend { display: block; margin-bottom: 0.35rem; font-weight: 500; }
  .bk-field input, .bk-field textarea, .bk-select {
    width: 100%; padding: 0.7rem 0.9rem; border: 1px solid var(--border-color); border-radius: 10px;
    background: var(--bg-primary); color: var(--text-primary); font: inherit;
  }
  .bk-field textarea { resize: vertical; }
  .bk-field input::placeholder, .bk-field textarea::placeholder { color: var(--text-muted); }
  .bk-field input:focus-visible, .bk-field textarea:focus-visible, .bk-select:focus-visible { border-color: var(--color-green); }
  .bk-hint { display: block; margin-top: 0.35rem; font-size: 0.85rem; color: var(--text-muted); }

  .bk-locations { border: 0; padding: 0; margin: 0 0 1.25rem; }
  .bk-location { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0; cursor: pointer; }
  .bk-location input { width: auto; }

  .bk-guests { margin: 0 0 1.25rem; }
  .bk-guest { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
  .bk-guest input { flex: 1; }
  .bk-guest-remove, .bk-add-guest {
    background: none; border: 1px solid var(--border-color); border-radius: 10px;
    padding: 0.6rem 0.9rem; cursor: pointer; color: var(--color-green-text); font: inherit;
  }
  .bk-add-guest:hover, .bk-guest-remove:hover { border-color: var(--color-green); }

  .bk-error { display: block; margin-top: 0.35rem; font-size: 0.85rem; color: #d64545; }
  .bk-error:empty { display: none; }
  .bk-form-error { margin: 0 0 1rem; }
  [data-theme='dark'] .bk-error { color: #ff8a8a; }

  .bk-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .bk-turnstile { margin-bottom: 1.25rem; }
  .bk-submit { width: 100%; }
  .bk-submit[disabled] { opacity: 0.6; cursor: default; }

  .bk-done-title { font-size: 1.3rem; margin: 0 0 0.5rem; }
  .bk-done-when { font-weight: 600; margin-bottom: 0.75rem; }
  .bk-done-body { color: var(--text-secondary); margin-bottom: 1rem; }
  .bk-done-links a { display: inline-block; margin-right: 1.25rem; }

  .bk-privacy { margin-top: 2.5rem; font-size: 0.9rem; }

  @media (max-width: 560px) {
    .bk-row { grid-template-columns: 1fr; gap: 0; }
    .bk-slots { grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bk-type { transition: none; }
    .bk-type:hover { transform: none; }
  }
</style>

<script>
  // The booking flow. Four steps in one page, because a booker who changes
  // their mind about the day should not lose the type they picked.
  //
  // State lives in the URL hash, so the browser Back button walks the steps and
  // a refresh does not throw the visitor back to the start.

  declare function t(event: string, data?: Record<string, unknown>): void;

  interface EventType {
    slug: string;
    name: string;
    description: string;
    durationMinutes: number;
    locations: string[];
  }
  interface Slot { startUTC: string; endUTC: string }
  type Days = Record<string, Slot[]>;

  const mounted = document.querySelector<HTMLElement>('.bk');
  if (mounted) {
    // Rebound so the null check narrows inside every nested function below.
    const root: HTMLElement = mounted;
    const S = JSON.parse(root.dataset.strings || '{}');
    const INTL = root.dataset.intl || 'en-GB';
    const LOCALE = root.dataset.locale || 'en';

    const panels = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('.bk-panel').forEach((p) => panels.set(p.dataset.step!, p));
    const status = root.querySelector<HTMLElement>('.bk-status')!;
    const trail = root.querySelector<HTMLElement>('.bk-trail')!;
    const form = root.querySelector<HTMLFormElement>('.bk-form')!;

    let types: EventType[] = [];
    let chosen: EventType | null = null;
    let month = '';
    let days: Days = {};
    let date = '';
    let slot: Slot | null = null;
    let zone = 'UTC';
    try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'; } catch { /* keep UTC */ }

    const say = (message: string) => { status.textContent = message; };
    const fmtDay = (iso: string) =>
      new Date(`${iso}T12:00:00Z`).toLocaleDateString(INTL, { weekday: 'long', day: 'numeric', month: 'long' });
    const fmtTime = (iso: string) =>
      new Date(iso).toLocaleTimeString(INTL, { hour: '2-digit', minute: '2-digit', timeZone: zone });
    const fmtDuration = (minutes: number) => {
      if (minutes < 60) return S.duration.minutes.replace('{n}', String(minutes));
      const hours = minutes / 60;
      return hours === 1 ? S.duration.hour : S.duration.hours.replace('{n}', String(hours));
    };

    /** Attribution: what earned this booking, captured on the visitor's first page. */
    function attribution(): Record<string, string> {
      let first: Record<string, string> = {};
      try { first = JSON.parse(sessionStorage.getItem('utm.first') || '{}'); } catch { /* private mode */ }
      const utm: Record<string, string> = {
        source: first.utm_source || 'website',
        medium: first.utm_medium || 'internal',
      };
      if (first.utm_campaign) utm.campaign = first.utm_campaign;
      try {
        const ref = document.referrer ? new URL(document.referrer) : null;
        if (ref && ref.origin === location.origin && ref.pathname !== location.pathname) {
          utm.content = ref.pathname.replace(/^\/|\/$/g, '').slice(0, 100) || 'home';
        } else if (first.utm_content) utm.content = first.utm_content;
      } catch { /* ignore */ }
      return utm;
    }

    const track = (event: string, extra: Record<string, unknown> = {}) => {
      if (typeof t !== 'function') return;
      const a = attribution();
      t(event, { locale: LOCALE, source: a.source, medium: a.medium, from: a.content || '', ...extra });
    };

    // ---- navigation -------------------------------------------------------

    function show(step: string) {
      panels.forEach((panel, name) => { panel.hidden = name !== step; });
      trail.hidden = step === 'type' || step === 'done';
      const crumbs = trail.querySelectorAll<HTMLButtonElement>('.bk-crumb');
      crumbs[0]!.textContent = chosen ? chosen.name : '';
      crumbs[0]!.hidden = !chosen;
      crumbs[1]!.textContent = date ? fmtDay(date) : '';
      crumbs[1]!.hidden = !date || step === 'date';
      crumbs[2]!.hidden = true;
      if (step === 'done') panels.get('done')!.focus();
    }

    function writeHash() {
      const parts: string[] = [];
      if (chosen) parts.push(`type=${chosen.slug}`);
      if (date) parts.push(`date=${date}`);
      if (slot) parts.push(`slot=${encodeURIComponent(slot.startUTC)}`);
      const next = parts.length ? `#${parts.join('&')}` : ' ';
      if (location.hash !== next) history.pushState(null, '', next);
    }

    function readHash(): Record<string, string> {
      const out: Record<string, string> = {};
      for (const pair of location.hash.replace(/^#/, '').split('&')) {
        const [k, v] = pair.split('=');
        if (k && v) out[k] = decodeURIComponent(v);
      }
      return out;
    }

    // ---- step one: the event types ---------------------------------------

    async function loadTypes() {
      say(S.calendar.loading);
      try {
        const response = await fetch(`/api/booking/types?locale=${LOCALE}`);
        if (!response.ok) throw new Error(String(response.status));
        types = (await response.json()).types as EventType[];
      } catch {
        say(S.errors.generic);
        return;
      }
      say('');
      const list = root.querySelector<HTMLElement>('.bk-types')!;
      if (types.length === 0) { list.textContent = S.empty; return; }
      list.replaceChildren(...types.map((type) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'bk-type';
        button.innerHTML =
          `<span class="bk-type-name"></span><span class="bk-type-meta"></span><p class="bk-type-desc"></p>`;
        button.querySelector('.bk-type-name')!.textContent = type.name;
        button.querySelector('.bk-type-meta')!.textContent =
          `${fmtDuration(type.durationMinutes)} · ${type.locations.map((l) => S.locations[l] ?? l).join(' / ')}`;
        button.querySelector('.bk-type-desc')!.textContent = type.description;
        button.addEventListener('click', () => pickType(type));
        return button;
      }));
    }

    function pickType(type: EventType) {
      chosen = type; date = ''; slot = null; days = {};
      month = new Date().toISOString().slice(0, 7);
      writeHash();
      track('booking_type_picked', { type: type.slug, minutes: type.durationMinutes });
      show('date');
      loadMonth();
    }

    // ---- step two: the month ---------------------------------------------

    function shiftMonth(by: number): string {
      const [y, m] = month.split('-').map(Number);
      const d = new Date(Date.UTC(y!, m! - 1 + by, 1));
      return `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`;
    }

    async function loadMonth() {
      const label = root.querySelector<HTMLElement>('.bk-month')!;
      const grid = root.querySelector<HTMLElement>('.bk-grid')!;
      const empty = root.querySelector<HTMLElement>('.bk-empty')!;
      label.textContent = new Date(`${month}-01T12:00:00Z`).toLocaleDateString(INTL, { month: 'long', year: 'numeric' });
      grid.replaceChildren();
      empty.hidden = true;
      say(S.calendar.loading);

      try {
        const response = await fetch(`/api/booking/availability?type=${chosen!.slug}&month=${month}`);
        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          say(body.error === 'calendar_unavailable' ? S.errors.calendarUnavailable : S.errors.generic);
          return;
        }
        days = (await response.json()).days as Days;
      } catch {
        say(S.errors.calendarUnavailable);
        return;
      }
      say('');
      renderWeekdays();
      renderGrid();
    }

    function renderWeekdays() {
      const head = root.querySelector<HTMLElement>('.bk-weekdays')!;
      if (head.childElementCount > 0) return;
      // 5 January 2026 was a Monday, so this walks Monday to Sunday whatever
      // the locale's own first day happens to be.
      head.replaceChildren(...Array.from({ length: 7 }, (_, i) => {
        const cell = document.createElement('span');
        cell.className = 'bk-weekday';
        cell.textContent = new Date(Date.UTC(2026, 0, 5 + i)).toLocaleDateString(INTL, { weekday: 'short' });
        return cell;
      }));
    }

    function renderGrid() {
      const grid = root.querySelector<HTMLElement>('.bk-grid')!;
      const empty = root.querySelector<HTMLElement>('.bk-empty')!;
      const [y, m] = month.split('-').map(Number);
      const first = new Date(Date.UTC(y!, m! - 1, 1));
      const length = new Date(Date.UTC(y!, m!, 0)).getUTCDate();
      const lead = (first.getUTCDay() + 6) % 7; // Monday-first

      const cells: HTMLElement[] = [];
      for (let i = 0; i < lead; i += 1) {
        const blank = document.createElement('div');
        blank.className = 'bk-day-cell is-blank';
        cells.push(blank);
      }
      for (let day = 1; day <= length; day += 1) {
        const iso = `${month}-${String(day).padStart(2, '0')}`;
        const cell = document.createElement('div');
        cell.className = 'bk-day-cell';
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'bk-day-btn';
        button.textContent = String(day);
        const free = (days[iso] || []).length > 0;
        button.disabled = !free;
        button.setAttribute('aria-pressed', String(iso === date));
        button.setAttribute('aria-label', fmtDay(iso));
        if (free) button.addEventListener('click', () => pickDate(iso));
        cell.appendChild(button);
        cells.push(cell);
      }
      grid.replaceChildren(...cells);
      empty.textContent = S.calendar.noDays;
      empty.hidden = Object.keys(days).length > 0;

      const back = root.querySelector<HTMLButtonElement>('.bk-nav[data-month="-1"]')!;
      back.disabled = month <= new Date().toISOString().slice(0, 7);
    }

    function pickDate(iso: string) {
      date = iso; slot = null;
      writeHash();
      show('time');
      renderSlots();
    }

    // ---- step three: the time --------------------------------------------

    function renderSlots() {
      root.querySelector<HTMLElement>('.bk-day')!.textContent = fmtDay(date);
      const holder = root.querySelector<HTMLElement>('.bk-slots')!;
      const list = days[date] || [];
      if (list.length === 0) { holder.textContent = S.times.none; return; }
      holder.replaceChildren(...list.map((candidate) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'bk-slot';
        button.textContent = fmtTime(candidate.startUTC);
        button.addEventListener('click', () => pickSlot(candidate));
        return button;
      }));
      renderZone();
    }

    function renderZone() {
      const label = root.querySelector<HTMLElement>('.bk-zone-label')!;
      const select = root.querySelector<HTMLSelectElement>('#bk-tz')!;
      label.textContent = S.times.zone.replace('{zone}', zone.replace(/_/g, ' '));
      if (select.options.length === 0) {
        let all: string[] = [zone];
        try { all = (Intl as never as { supportedValuesOf(k: string): string[] }).supportedValuesOf('timeZone'); } catch { /* older browser */ }
        select.replaceChildren(...all.map((name) => {
          const option = document.createElement('option');
          option.value = name;
          option.textContent = name.replace(/_/g, ' ');
          option.selected = name === zone;
          return option;
        }));
        select.addEventListener('change', () => { zone = select.value; renderSlots(); });
      }
    }

    function pickSlot(candidate: Slot) {
      slot = candidate;
      writeHash();
      track('booking_slot_picked', { type: chosen!.slug, date });
      show('details');
      renderForm();
    }

    // ---- step four: the details ------------------------------------------

    function renderForm() {
      const set = (selector: string, text: string) => {
        const node = root.querySelector<HTMLElement>(selector);
        if (node) node.textContent = text;
      };
      set('.bk-form-title', S.form.heading);
      set('.bk-chosen', `${chosen!.name} · ${fmtDay(date)} · ${fmtTime(slot!.startUTC)}`);
      set('label[for="bk-first"]', S.form.firstName);
      set('label[for="bk-last"]', S.form.lastName);
      set('label[for="bk-email"]', S.form.email);
      set('label[for="bk-phone"]', S.form.phone);
      set('.bk-phone .bk-hint', S.form.phoneHelp);
      set('label[for="bk-notes"]', `${S.form.question} (${S.form.optional})`);
      set('.bk-add-guest', S.form.addGuests);
      set('.bk-submit', S.form.submit);
      set('.bk-locations legend', S.form.location);

      const fieldset = root.querySelector<HTMLElement>('.bk-locations')!;
      fieldset.querySelectorAll('.bk-location').forEach((n) => n.remove());
      const error = fieldset.querySelector('.bk-error')!;
      chosen!.locations.forEach((kind, index) => {
        const label = document.createElement('label');
        label.className = 'bk-location';
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'location';
        input.value = kind;
        input.checked = index === 0;
        input.addEventListener('change', togglePhone);
        const text = document.createElement('span');
        text.textContent = S.locations[kind] ?? kind;
        label.append(input, text);
        fieldset.insertBefore(label, error);
      });
      root.querySelector<HTMLElement>('.bk-guests')!.hidden = false;
      togglePhone();
    }

    function togglePhone() {
      const picked = form.querySelector<HTMLInputElement>('input[name="location"]:checked');
      root.querySelector<HTMLElement>('.bk-phone')!.hidden = picked?.value !== 'phone';
    }

    root.querySelector<HTMLButtonElement>('.bk-add-guest')!.addEventListener('click', () => {
      const list = root.querySelector<HTMLElement>('.bk-guest-list')!;
      if (list.childElementCount >= 5) return;
      const row = document.createElement('div');
      row.className = 'bk-guest';
      const input = document.createElement('input');
      input.type = 'email';
      input.placeholder = S.form.guestEmail;
      input.setAttribute('aria-label', S.form.guestEmail);
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'bk-guest-remove';
      remove.textContent = '×';
      remove.setAttribute('aria-label', S.form.removeGuest);
      remove.addEventListener('click', () => row.remove());
      row.append(input, remove);
      list.appendChild(row);
      input.focus();
    });

    function clearErrors() {
      root.querySelectorAll<HTMLElement>('.bk-error').forEach((node) => { node.textContent = ''; });
      const banner = root.querySelector<HTMLElement>('.bk-form-error')!;
      banner.hidden = true;
    }

    function showFieldErrors(fields: Record<string, string>) {
      for (const [name, code] of Object.entries(fields)) {
        const node = root.querySelector<HTMLElement>(`.bk-error[data-for="${name}"]`);
        if (!node) continue;
        node.textContent =
          code === 'invalid' && name === 'email' ? S.errors.email
          : code === 'invalid' && name === 'phone' ? S.errors.phone
          : S.errors.required;
      }
      const first = root.querySelector<HTMLElement>('.bk-error:not(:empty)');
      first?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      const submit = form.querySelector<HTMLButtonElement>('.bk-submit')!;
      submit.disabled = true;
      submit.textContent = S.form.submitting;

      const data = new FormData(form);
      const guests = Array.from(root.querySelectorAll<HTMLInputElement>('.bk-guest input'))
        .map((input) => input.value.trim())
        .filter(Boolean);
      const turnstile = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');

      const body = {
        type: chosen!.slug,
        startUTC: slot!.startUTC,
        location: String(data.get('location') || ''),
        firstName: String(data.get('firstName') || ''),
        lastName: String(data.get('lastName') || ''),
        email: String(data.get('email') || ''),
        phone: String(data.get('phone') || ''),
        notes: String(data.get('notes') || ''),
        nickname: String(data.get('nickname') || ''),
        timezone: zone,
        guests,
        turnstileToken: turnstile?.value || '',
        utm: attribution(),
      };

      let response: Response;
      try {
        response = await fetch('/api/booking/bookings', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
      } catch {
        banner(S.errors.generic);
        return;
      }

      const payload = await response.json().catch(() => ({}));

      if (response.ok) {
        track('call_booked', { type: chosen!.slug, minutes: chosen!.durationMinutes, location: body.location });
        renderDone(payload, body.email);
        return;
      }

      if (payload.fields) showFieldErrors(payload.fields);
      banner(
        payload.error === 'slot_taken' ? S.errors.slotTaken
        : payload.error === 'rate_limited' ? S.errors.rateLimited
        : payload.error === 'calendar_unavailable' ? S.errors.calendarUnavailable
        : payload.fields ? '' : S.errors.generic,
      );

      function banner(message: string) {
        const node = root.querySelector<HTMLElement>('.bk-form-error')!;
        node.textContent = message;
        node.hidden = !message;
        submit.disabled = false;
        submit.textContent = S.form.submit;
      }
    });

    function renderDone(payload: { booking?: { meetLink?: string | null }; manageUrl?: string }, email: string) {
      root.querySelector<HTMLElement>('.bk-done-title')!.textContent = S.confirmed.heading;
      root.querySelector<HTMLElement>('.bk-done-when')!.textContent =
        `${chosen!.name} · ${fmtDay(date)} · ${fmtTime(slot!.startUTC)}`;
      root.querySelector<HTMLElement>('.bk-done-body')!.textContent = S.confirmed.body.replace('{email}', email);
      const links = root.querySelector<HTMLElement>('.bk-done-links')!;
      links.replaceChildren();
      if (payload.booking?.meetLink) {
        const meet = document.createElement('a');
        meet.href = payload.booking.meetLink;
        meet.textContent = S.confirmed.meet;
        meet.rel = 'noopener';
        links.appendChild(meet);
      }
      if (payload.manageUrl) {
        const manage = document.createElement('a');
        manage.href = payload.manageUrl;
        manage.textContent = S.confirmed.manage;
        links.appendChild(manage);
      }
      show('done');
    }

    // ---- wiring -----------------------------------------------------------

    root.querySelectorAll<HTMLButtonElement>('.bk-nav').forEach((button) => {
      button.addEventListener('click', () => {
        month = shiftMonth(Number(button.dataset.month));
        loadMonth();
      });
    });

    trail.querySelectorAll<HTMLButtonElement>('.bk-crumb').forEach((crumb) => {
      crumb.addEventListener('click', () => {
        const target = crumb.dataset.goto!;
        if (target === 'type') { chosen = null; date = ''; slot = null; }
        if (target === 'date') { date = ''; slot = null; }
        writeHash();
        show(target);
      });
    });

    window.addEventListener('popstate', () => {
      const state = readHash();
      if (!state.type) { chosen = null; date = ''; slot = null; show('type'); return; }
      const found = types.find((candidate) => candidate.slug === state.type);
      if (!found) { show('type'); return; }
      chosen = found;
      if (!state.date) { date = ''; slot = null; show('date'); return; }
      date = state.date;
      if (!state.slot) { slot = null; show('time'); renderSlots(); return; }
      show('details');
    });

    loadTypes();
  }
</script>
