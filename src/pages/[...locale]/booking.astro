---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, getLocalePath, localeStaticPaths, type Locale } from '../../i18n/index';
import BookingCalendar from '../../components/BookingCalendar.astro';
import '../../styles/booking.css';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const i18n = t(locale);
const intl = { en: 'en-GB', es: 'es-ES', ca: 'ca-ES', tl: 'tl-PH' }[locale];
---

<BaseLayout
  title={i18n.seo.bookACallTitle}
  description={i18n.seo.bookACallDescription}
  locale={locale}
  currentPath={getLocalePath(locale, '/booking/')}
>
  <section class="section bk-page">
    <div class="container">
      <h1 class="section-title">{i18n.bookACall.title}</h1>
      <p class="bk-subtitle text-muted">{i18n.bookACall.description}</p>

      <div
        class="bk"
        data-locale={locale}
        data-intl={intl}
        data-strings={JSON.stringify(i18n.booking)}
        data-turnstile="0x4AAAAAAEp0pwvUWeFyYq42"
        data-home={getLocalePath(locale, '/')}
        data-book={getLocalePath(locale, '/booking/')}
      >
        <!-- The stub. One object that fills in as choices are made and, at the
             end, is the confirmation. Sticky at the top on a phone, because the
             dock owns the bottom; a column on a wide screen. Each filled line is
             a button back to that step, so it doubles as navigation. -->
        <!-- The intro sits above the flow on a phone and in the left rail,
             under the stub, on a wide screen: one composition, not an article
             with a form beneath it. -->
        <details class="bk-about" open>
          <summary class="bk-about-toggle">{i18n.booking.expectToggle}</summary>
          <div class="bk-about-body">
            <p class="bk-intro">{i18n.bookACall.intro}</p>
            <h2 class="bk-expect-title">{i18n.bookACall.expectTitle}</h2>
            <ul class="bk-expect dot-list">
              {i18n.bookACall.expect.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        </details>

        <aside class="bk-stub" aria-label={i18n.booking.steps.details}>
          <ol class="bk-stub-lines">
            <li class="bk-stub-line" data-line="type" hidden><button type="button" data-goto="type"><span class="bk-stub-text"></span><span class="bk-stub-change"></span></button></li>
            <li class="bk-stub-line" data-line="date" hidden><button type="button" data-goto="date"><span class="bk-stub-text"></span><span class="bk-stub-change"></span></button></li>
            <li class="bk-stub-line" data-line="time" hidden><button type="button" data-goto="time"><span class="bk-stub-text"></span><span class="bk-stub-change"></span></button></li>
          </ol>
          <p class="bk-stub-hint" aria-live="polite" tabindex="-1"></p>
        </aside>

        <div class="bk-stage">
          <p class="bk-status" role="status" aria-live="polite" hidden><span class="bk-status-text"></span> <button type="button" class="bk-retry" hidden></button></p>

          <section class="bk-panel" data-step="type">
            <div class="bk-types"></div>
          </section>

          <BookingCalendar locale={locale} />

          <form class="bk-panel bk-form" data-step="details" novalidate hidden>
            <h2 class="bk-form-title" tabindex="-1"></h2>

            <fieldset class="bk-group">
              <legend class="bk-group-title" data-copy="aboutYou"></legend>
              <div class="bk-row">
                <p class="bk-field">
                  <label for="bk-first"></label>
                  <input id="bk-first" name="firstName" type="text" autocomplete="given-name" required />
                  <span class="bk-error" data-for="firstName" role="alert"></span>
                </p>
                <p class="bk-field">
                  <label for="bk-last"></label>
                  <input id="bk-last" name="lastName" type="text" autocomplete="family-name" required />
                  <span class="bk-error" data-for="lastName" role="alert"></span>
                </p>
              </div>
              <p class="bk-field">
                <label for="bk-email"></label>
                <input id="bk-email" name="email" type="email" autocomplete="email" inputmode="email" required />
                <span class="bk-error" data-for="email" role="alert"></span>
              </p>
              <div class="bk-guests">
                <div class="bk-guest-list"></div>
                <button type="button" class="bk-add-guest">
                  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                  <span></span>
                </button>
                <span class="bk-error" data-for="guests" role="alert"></span>
              </div>
            </fieldset>

            <fieldset class="bk-group bk-locations">
              <legend class="bk-group-title"></legend>
              <!-- Two tiles, each a real radio. The icon says what the medium is,
                   the second line says what will happen, and the chosen one
                   carries the brand green. -->
              <div class="bk-tiles"></div>
              <span class="bk-error" data-for="location" role="alert"></span>
              <div class="bk-field bk-phone" hidden>
                <label for="bk-phone"></label>
                <div class="bk-phone-row">
                  <button type="button" class="bk-cc" id="bk-cc" aria-haspopup="dialog">
                    <span class="bk-cc-flag" aria-hidden="true"></span><span class="bk-cc-code"></span>
                    <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <input type="hidden" name="cc" value="" />
                  <input id="bk-phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" />
                </div>
                <span class="bk-hint"></span>
                <span class="bk-error" data-for="phone" role="alert"></span>
              </div>
            </fieldset>

            <fieldset class="bk-group">
              <legend class="bk-group-title" data-copy="prepare"></legend>
              <p class="bk-field">
                <label for="bk-notes"></label>
                <textarea id="bk-notes" name="notes" rows="4" maxlength="2000"></textarea>
                <span class="bk-error" data-for="notes" role="alert"></span>
              </p>
            </fieldset>

            <!-- Never filled by a person. A bot that fills it gets a cheerful
                 nothing rather than an error telling it what went wrong. -->
            <p class="bk-hp" aria-hidden="true">
              <label for="bk-nickname">Nickname</label>
              <input id="bk-nickname" name="nickname" type="text" tabindex="-1" autocomplete="off" />
            </p>

            <div class="bk-turnstile"></div>
            <p class="bk-error bk-form-error" role="alert" hidden></p>
            <button type="submit" class="bk-submit"></button>
            <p class="bk-submit-hint" aria-live="polite"></p>
          </form>

          <section class="bk-panel bk-done" data-step="done" hidden tabindex="-1">
            <!-- The result, in place of the form: the stub completing as a
                 ticket. Success draws one green check and lists what happened;
                 a failure names which failure and offers the one right action. -->
            <div class="bk-ticket">
              <div class="bk-ticket-mark" aria-hidden="true"></div>
              <h2 class="bk-done-title"></h2>
              <p class="bk-done-lead"></p>
              <dl class="bk-ticket-facts"></dl>
              <ul class="bk-ticket-status"></ul>
              <p class="bk-done-actions"></p>
            </div>
          </section>
        </div>
      </div>

      <!-- Country picker: the site's own bottom sheet, with a search box. -->
      <div class="post-sheet bk-sheet" id="bk-cc-sheet" role="dialog" aria-modal="true" aria-labelledby="bk-cc-title" hidden>
        <div class="post-sheet-backdrop" data-overlay-close></div>
        <div class="post-sheet-panel bk-sheet-panel" tabindex="-1">
          <div class="post-sheet-grabber" aria-hidden="true"></div>
          <div class="post-sheet-head">
            <h2 id="bk-cc-title" class="bk-sheet-title"></h2>
            <button type="button" class="bk-sheet-close" data-overlay-close aria-label=""><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
          </div>
          <div class="bk-sheet-search"><input type="search" id="bk-cc-search" autocomplete="off" /></div>
          <ul class="bk-cc-list" role="listbox"></ul>
        </div>
      </div>

      <p class="bk-privacy text-muted">
        {i18n.bookACall.privacyNote}
        <a href={getLocalePath(locale, '/privacy/')}>{i18n.bookACall.privacyLink}</a>.
      </p>
    </div>
  </section>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__bkTurnstileReady" async defer></script>
</BaseLayout>

<!-- Global on purpose. Astro scopes styles to the markup it can see and prunes
     rules whose selectors never appear in the template, and every element in
     this flow is created at runtime. Every selector is prefixed .bk- so nothing
     leaks past this page. Colours are the site's tokens only. -->

<script>
  import '../../scripts/booking';
</script>
