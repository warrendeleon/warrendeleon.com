---
import BookingPage from '../../components/BookingPage.astro';
import { t, localeStaticPaths, type Locale } from '../../i18n/index';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const i18n = t(locale);
---

<BookingPage locale={locale} audience="public" path="/booking/" copy={i18n.bookACall} seoTitle={i18n.seo.bookACallTitle} seoDescription={i18n.seo.bookACallDescription} />
